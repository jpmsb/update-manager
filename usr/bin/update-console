            QPushButton[negativeOption='true'][selected='true'] {
                background-color: #8e2c33;
                border: 2px solid #ff7b72;
            }
        """

        self._help_button_qss = """
            QPushButton {
                background-color: #24292f;
                color: #79c0ff;
                border: 1px solid #444c56;
                border-radius: 5px;
                padding: 0px 2px;
                margin: 0px;
                min-height: 0px;
            }
            QPushButton:hover {
                background-color: #323942;
                color: #a5d6ff;
                border-color: #58a6ff;
            }
            QPushButton[defaultOption='true'] {
                background-color: #1b4d3e;
                color: #ffffff;
                border: 1px solid #2ea043;
                font-weight: bold;
            }
            QPushButton[defaultOption='true']:hover {
                background-color: #236853;
                border-color: #3fb950;
            }
            QPushButton[selected='true'] {
                background-color: #3b4b5e;
                color: #ffffff;
                border: 2px solid #58a6ff;
                font-weight: bold;
            }
            QPushButton[defaultOption='true'][selected='true'] {
                background-color: #2e7d62;
                border: 2px solid #56d364;
            }
            QPushButton[negativeOption='true'] {
                background-color: #5c1f24;
                color: #ffffff;
                border: 1px solid #da3633;
            }
            QPushButton[negativeOption='true']:hover {
                background-color: #7a2a30;
                border-color: #f85149;
            }
            QPushButton[negativeOption='true'][selected='true'] {
                background-color: #8e2c33;
                border: 2px solid #ff7b72;
            }
        """

        self._btn_container = QWidget(self.viewport())
        self._btn_container.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self._btn_container.setVisible(False)
        self._btn_layout = QHBoxLayout(self._btn_container)
        self._btn_layout.setContentsMargins(0, 0, 0, 0)
        self._btn_layout.setSpacing(6)
        self._btn_container.setStyleSheet(self._button_qss.replace("__FS__", "12"))
        self.verticalScrollBar().valueChanged.connect(self._reposition_prompt_buttons)

        self._scroll_bottom_btn = QPushButton("↓", self.viewport())
        self._scroll_bottom_btn.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self._scroll_bottom_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._scroll_bottom_btn.setToolTip(tr("scroll_bottom"))
        self._scroll_bottom_btn.setFixedSize(36, 36)
        self._scroll_bottom_btn.setStyleSheet(
            """
            QPushButton {
                background-color: rgba(36, 41, 47, 230);
                color: #79c0ff;
                border: 1px solid #444c56;
                border-radius: 18px;
                font-size: 16pt;
                font-weight: bold;
                padding: 0px;
            }
            QPushButton:hover {
                background-color: #323942;
                color: #a5d6ff;
                border-color: #58a6ff;
            }
            """
        )
        self._scroll_bottom_btn.clicked.connect(self._scroll_to_bottom)
        self._scroll_bottom_btn.setVisible(False)

        # Search bar (Ctrl+F) and transient zoom indicator, overlaid on the viewport.
        self._search = QLineEdit(self.viewport())
        self._search.setPlaceholderText(tr("search_placeholder"))
        self._search.setClearButtonEnabled(True)
        self._search.setFixedWidth(300)
        self._search.setStyleSheet(self._search_qss(found=True))
        self._search.textChanged.connect(lambda _t: self._find(backwards=False, restart=True))
        self._search.installEventFilter(self)
        self._search.setVisible(False)

        self._toast = QLabel(self.viewport())
        self._toast.setStyleSheet(
            "background-color: rgba(36, 41, 47, 230); color: #c9d1d9; border: 1px solid #444c56;"
            " border-radius: 6px; padding: 4px 10px; font-size: 11pt;"
        )
        self._toast.setVisible(False)
        self._toast_timer = QTimer(self)
        self._toast_timer.setSingleShot(True)
        self._toast_timer.setInterval(1200)
        self._toast_timer.timeout.connect(lambda: self._toast.setVisible(False))

        self.setStyleSheet(
            f"""
            QPlainTextEdit {{
                background-color: {DEFAULT_BG};
                color: {DEFAULT_FG};
                border: none;
                padding: 8px;
            }}
            """
        )
        self.setFont(pick_mono_font())
        self.setCursorWidth(max(self.fontMetrics().horizontalAdvance("M"), 8))

    def resizeEvent(self, event) -> None:  # noqa: N802
        super().resizeEvent(event)
        self._reposition_prompt_buttons()
        self._position_scroll_bottom_button()
        self._position_overlays()

    # ---- search (Ctrl+F) -------------------------------------------------
    @staticmethod
    def _search_qss(found: bool) -> str:
        border = "#444c56" if found else "#da3633"
        return (
            f"QLineEdit {{ background-color: #0d1117; color: #c9d1d9; border: 1px solid {border};"
            " border-radius: 6px; padding: 4px 8px; font-size: 11pt; }"
            " QLineEdit:focus { border-color: " + ("#58a6ff" if found else "#da3633") + "; }"
        )

    def _position_overlays(self) -> None:
        vp = self.viewport()
        self._search.move(max(14, vp.width() - self._search.width() - 14), 14)
        self._search.raise_()
        self._toast.move(14, 14)
        self._toast.raise_()

    def show_search(self) -> None:
        self._search.setVisible(True)
        self._position_overlays()
        self._search.setFocus(Qt.FocusReason.ShortcutFocusReason)
        self._search.selectAll()

    def close_search(self) -> None:
        self._search.setVisible(False)
        cur = self.textCursor()
        if cur.hasSelection():  # a leftover selection would turn Ctrl+C into "copy"
            cur.clearSelection()
            self.setTextCursor(cur)
        self.setFocus(Qt.FocusReason.OtherFocusReason)

    def _find(self, backwards: bool, restart: bool = False) -> None:
        text = self._search.text()
        if not text:
            self._search.setStyleSheet(self._search_qss(found=True))
            return
        flags = QTextDocument.FindFlag.FindBackward if backwards else QTextDocument.FindFlag(0)
        doc = self.document()
        cur = self.textCursor()
        if restart and cur.hasSelection():  # incremental typing keeps the current match
            cur.setPosition(cur.selectionStart())
        found = doc.find(text, cur, flags)
        if found.isNull():  # wrap around
            wrap = QTextCursor(doc)
            wrap.movePosition(
                QTextCursor.MoveOperation.End if backwards else QTextCursor.MoveOperation.Start
            )
            found = doc.find(text, wrap, flags)
        self._search.setStyleSheet(self._search_qss(found=not found.isNull()))
        if not found.isNull():
            self.setTextCursor(found)
            self.ensureCursorVisible()

    def eventFilter(self, obj, event) -> bool:  # noqa: N802
        if obj is self._search and event.type() == QEvent.Type.KeyPress:
            key = event.key()
            if key == Qt.Key.Key_Escape:
                self.close_search()
                return True
            if key in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
                self._find(backwards=bool(event.modifiers() & Qt.KeyboardModifier.ShiftModifier))
                return True
        return super().eventFilter(obj, event)

    # ---- save output (Ctrl+S) --------------------------------------------
    def save_output(self) -> None:
        default = os.path.join(os.path.expanduser("~"), time.strftime("update-console-%Y%m%d-%H%M.log"))
        path, _filter = QFileDialog.getSaveFileName(self, tr("save_title"), default, "Log (*.log *.txt);;*")
        if not path:
            return
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(self.toPlainText())
        except OSError as exc:
            QMessageBox.warning(self, tr("save_title"), tr("save_failed", error=exc))

    # ---- zoom feedback ---------------------------------------------------
    def _ui_font_pt(self) -> int:
        return max(9, round(self._font_size * 0.75))  # 16 pt console -> 12 pt buttons

    def _hint_qss(self) -> str:
        return f"color: #8b949e; font-size: {max(8, self._ui_font_pt() - 2)}pt; background: transparent; padding-left: 6px;"

    def _apply_ui_scale(self) -> None:
        self._btn_container.setStyleSheet(self._button_qss.replace("__FS__", str(self._ui_font_pt())))
        if self._prompt_hint is not None:
            self._prompt_hint.setStyleSheet(self._hint_qss())

    def _show_toast(self, text: str) -> None:
        self._toast.setText(text)
        self._toast.adjustSize()
        self._position_overlays()
        self._toast.setVisible(True)
        self._toast_timer.start()

    def _restyle_prompt_chips(self) -> None:
        selected_opt = (
            self._active_options[self._selected_opt_idx]
            if self._selected_opt_idx is not None and 0 <= self._selected_opt_idx < len(self._active_options)
            else None
        )
        for idx, btn in enumerate(self._prompt_buttons):
            is_sel = self._selected_opt_idx == idx
            btn.setProperty("selected", "true" if is_sel else "false")
            btn.style().unpolish(btn)
            btn.style().polish(btn)
        for _bn, _sc, _ol, hbtn in self._help_buttons:
            is_sel = selected_opt is not None and hbtn.property("optKey") == selected_opt
            hbtn.setProperty("selected", "true" if is_sel else "false")
            hbtn.style().unpolish(hbtn)
            hbtn.style().polish(hbtn)

    def _reposition_prompt_buttons(self) -> None:
        if self._active_prompt_block is None or not self._prompt_buttons:
            return
        block = self.document().findBlockByNumber(self._active_prompt_block)
        if not block.isValid():
            self._btn_container.setVisible(False)
            return
        cur = QTextCursor(block)
        cur.setPosition(block.position() + len(block.text()))
        rect = self.cursorRect(cur)
        vw = self.viewport().width()
        vh = self.viewport().height()
        if rect.bottom() < 0 or rect.top() > vh:
            self._btn_container.setVisible(False)
            return

        self._btn_layout.activate()
        self._btn_container.adjustSize()
        bw = self._btn_container.width()
        bh = self._btn_container.height()

        x = rect.right() + 10
        y = rect.top() + (rect.height() - bh) // 2
        if x + bw > vw - 8:
            x = max(8, vw - bw - 10)
            if rect.bottom() + 4 + bh <= vh - 4:
                x = 8
                y = rect.bottom() + 4

        y = max(4, min(y, max(vh - bh - 4, 4)))
        self._btn_container.move(max(x, 8), y)
        self._btn_container.setVisible(True)
        self._btn_container.raise_()

        for block_num, key_col, _orig_label, btn in self._help_buttons:
            hblock = self.document().findBlockByNumber(block_num)
            if not hblock.isValid():
                btn.setVisible(False)
                continue
            hcur = QTextCursor(hblock)
            hcur.setPosition(hblock.position() + min(key_col, len(hblock.text())))
            hrect = self.cursorRect(hcur)
            if hrect.bottom() < 0 or hrect.top() > vh:
                btn.setVisible(False)
                continue
            btn.adjustSize()
            btn.setFixedHeight(max(hrect.height() - 1, 20))
            hx = max(0, hrect.left() - 3)
            hy = max(0, hrect.top())
            btn.move(hx, hy)
            btn.setVisible(True)
            btn.raise_()

    def set_inline_prompt_links(self, options: list[str], default_opt: str | None) -> None:
        """Render real clickable QPushButton widgets inline next to the active prompt."""
        doc = self.document()
        block = doc.lastBlock()
        if not _PROMPT_RE.match(block.text().rstrip()):
            return

        self.clear_inline_prompt_links()
        self._active_prompt_block = block.blockNumber()
        self._active_options = list(options)
        self._active_default_opt = default_opt
        self._selected_opt_idx = None

        for opt in options:
            label = option_button_label(opt, options)
            if opt == default_opt:
                label = f"{label} (Enter)"
            btn = QPushButton(label, self._btn_container)
            btn.setFocusPolicy(Qt.FocusPolicy.NoFocus)
            btn.setCursor(Qt.CursorShape.PointingHandCursor)
            if opt == default_opt:
                btn.setProperty("defaultOption", "true")
            if opt.lower() in ("n", "no", "não", "nein"):
                btn.setProperty("negativeOption", "true")
            btn.clicked.connect(lambda _checked=False, o=opt: self.prompt_option_clicked.emit(o))
            self._btn_layout.addWidget(btn)
            self._prompt_buttons.append(btn)

        # Keyboard hint: arrows pick an option, Enter confirms it.
        hint = QLabel(tr("prompt_hint"), self._btn_container)
        hint.setStyleSheet(self._hint_qss())
        self._btn_layout.addWidget(hint)
        self._prompt_hint = hint

        # Also add per-line buttons for expanded '?' option descriptions (#1 : key - desc).
        prev = block.previous()
        steps = 0
        help_entries: list[tuple[int, int, str, str]] = []
        while prev.isValid() and steps < 25:
            m = _HELP_OPT_RE.match(prev.text())
            if m:
                help_entries.append((prev.blockNumber(), m.start(1), m.group(1), m.group(2)))
            elif help_entries and not prev.text().strip():
                break
            elif help_entries:
                break
            prev = prev.previous()
            steps += 1

        for block_num, start_col, btn_label, opt_key in reversed(help_entries):
            hblock = doc.findBlockByNumber(block_num)
            if hblock.isValid():
                rcur = QTextCursor(hblock)
                rcur.setPosition(hblock.position() + start_col)
                rcur.setPosition(hblock.position() + start_col + len(btn_label), QTextCursor.MoveMode.KeepAnchor)
                rcur.insertText(" " * len(btn_label))

            hbtn = QPushButton(btn_label, self.viewport())
            hbtn.setFont(pick_mono_font(self._font_size))
            hbtn.setStyleSheet(self._help_button_qss)
            hbtn.setFocusPolicy(Qt.FocusPolicy.NoFocus)
            hbtn.setCursor(Qt.CursorShape.PointingHandCursor)
            hbtn.setProperty("optKey", opt_key)
            if opt_key == default_opt:
                hbtn.setProperty("defaultOption", "true")
            if opt_key.lower() in ("n", "no", "não", "nein"):
                hbtn.setProperty("negativeOption", "true")
            hbtn.clicked.connect(lambda _checked=False, o=opt_key: self.prompt_option_clicked.emit(o))
            self._help_buttons.append((block_num, start_col, btn_label, hbtn))

        self._btn_container.setVisible(True)
        self._reposition_prompt_buttons()
        if self._follow_tail:
            self.ensureCursorVisible()

    def _clear_help_highlight(self) -> None:
        if self._highlighted_help_span is None:
            return
        block_num, start_col, length = self._highlighted_help_span
        self._highlighted_help_span = None
        block = self.document().findBlockByNumber(block_num)
        if block.isValid() and start_col + length <= len(block.text()):
            fmt = QTextCharFormat()
            fmt.setFont(pick_mono_font())
            fmt.setForeground(QColor(DEFAULT_FG))
            fmt.setBackground(QColor(DEFAULT_BG))
            cur = QTextCursor(block)
            cur.setPosition(block.position() + start_col)
            cur.setPosition(block.position() + start_col + length, QTextCursor.MoveMode.KeepAnchor)
            cur.setCharFormat(fmt)

    def _restore_help_buttons(self, chosen_opt: str | None = None) -> None:
        if not self._help_buttons:
            return
        doc = self.document()
        for block_num, start_col, orig_label, hbtn in self._help_buttons:
            opt_key = hbtn.property("optKey")
            hbtn.setVisible(False)
            hbtn.deleteLater()
            hblock = doc.findBlockByNumber(block_num)
            if hblock.isValid() and start_col + len(orig_label) <= len(hblock.text()):
                rcur = QTextCursor(hblock)
                rcur.setPosition(hblock.position() + start_col)
                rcur.setPosition(hblock.position() + start_col + len(orig_label), QTextCursor.MoveMode.KeepAnchor)
                rcur.insertText(orig_label)
                if chosen_opt is not None and opt_key == chosen_opt:
                    hl_fmt = QTextCharFormat()
                    hl_font = pick_mono_font()
                    hl_font.setBold(True)
                    hl_fmt.setFont(hl_font)
                    hl_fmt.setForeground(QColor("#ffffff"))
                    hl_fmt.setBackground(QColor("#1b4d3e" if opt_key == self._active_default_opt else "#3b4b5e"))
                    rcur.setPosition(hblock.position() + start_col)
                    rcur.setPosition(hblock.position() + start_col + len(orig_label), QTextCursor.MoveMode.KeepAnchor)
                    rcur.setCharFormat(hl_fmt)
                    self._highlighted_help_span = (block_num, start_col, len(orig_label))
        self._help_buttons.clear()
        if self._follow_tail:
            self._snap_cursor_to_input()

    def _clear_prompt_buttons(self) -> None:
        self._btn_container.setVisible(False)
        for btn in self._prompt_buttons:
            self._btn_layout.removeWidget(btn)
            btn.deleteLater()
        self._prompt_buttons.clear()
        if self._prompt_hint is not None:
            self._btn_layout.removeWidget(self._prompt_hint)
            self._prompt_hint.deleteLater()
            self._prompt_hint = None

    def show_confirm_cancel_buttons(self, chosen_opt: str | None = None) -> None:
        """Replace option buttons with Confirm / Clear and highlight chosen option in text."""
        doc = self.document()
        block = doc.lastBlock()
        self._clear_prompt_buttons()
        self._clear_help_highlight()
        self._restore_help_buttons(chosen_opt=chosen_opt)

        self._active_prompt_block = block.blockNumber()
        self._active_options = ["__confirm__", "__cancel__"]
        self._active_default_opt = "__confirm__"
        self._selected_opt_idx = None

        confirm_btn = QPushButton(tr("btn_confirm"), self._btn_container)
        confirm_btn.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        confirm_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        confirm_btn.setProperty("defaultOption", "true")
        confirm_btn.clicked.connect(self.prompt_confirm_clicked.emit)
        self._btn_layout.addWidget(confirm_btn)
        self._prompt_buttons.append(confirm_btn)

        cancel_btn = QPushButton(tr("btn_cancel"), self._btn_container)
        cancel_btn.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        cancel_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        cancel_btn.setProperty("negativeOption", "true")
        cancel_btn.clicked.connect(self.prompt_clear_clicked.emit)
        self._btn_layout.addWidget(cancel_btn)
        self._prompt_buttons.append(cancel_btn)

        self._btn_container.setVisible(True)
        self._reposition_prompt_buttons()
        if self._follow_tail:
            self.ensureCursorVisible()

    def clear_inline_prompt_links(self) -> None:
        """Hide and remove inline prompt buttons and restore masked help-line labels."""
        self._active_prompt_block = None
        self._active_options = []
        self._active_default_opt = None
        self._selected_opt_idx = None
        self._clear_prompt_buttons()
        self._clear_help_highlight()
        self._restore_help_buttons(chosen_opt=None)

    def _snap_cursor_to_input(self) -> None:
        cur = self._last_block_cursor()
        block = cur.block()
        col = min(max(getattr(self, "_line_col", len(block.text())), 0), len(block.text()))
        cur.setPosition(block.position() + col)
        was_updating = self._updating_scroll
        self._updating_scroll = True
        try:
            self.setTextCursor(cur)
        finally:
            self._updating_scroll = was_updating

    def mouseReleaseEvent(self, event) -> None:  # noqa: N802
        super().mouseReleaseEvent(event)
        if not self.textCursor().hasSelection() and self._follow_tail:
            self._snap_cursor_to_input()

    def _paste_from_clipboard(self) -> None:
        clip = QApplication.clipboard()
        if clip is not None and clip.text():
            self._scroll_to_bottom()
            self._snap_cursor_to_input()
            self.input_bytes.emit(clip.text().encode("utf-8", errors="replace"))

    def contextMenuEvent(self, event) -> None:  # noqa: N802
        menu = QMenu(self)
        copy_act = menu.addAction(tr("ctx_copy"))
        copy_act.setEnabled(self.textCursor().hasSelection())
        copy_act.triggered.connect(self.copy)

        paste_act = menu.addAction(tr("ctx_paste"))
        clip = QApplication.clipboard()
        paste_act.setEnabled(bool(clip and clip.text()))
        paste_act.triggered.connect(self._paste_from_clipboard)

        menu.addSeparator()
        menu.addAction(tr("ctx_find")).triggered.connect(self.show_search)
        menu.addAction(tr("ctx_save")).triggered.connect(self.save_output)
        menu.addSeparator()
        menu.addAction(tr("ctx_zoom_in")).triggered.connect(lambda: self.set_font_size(self._font_size + 1))
        menu.addAction(tr("ctx_zoom_out")).triggered.connect(lambda: self.set_font_size(self._font_size - 1))
        menu.addAction(tr("ctx_zoom_reset")).triggered.connect(lambda: self.set_font_size(FONT_POINT_SIZE))

        menu.exec(event.globalPos())

    def set_font_size(self, point_size: int) -> None:
        clamped = max(8, min(32, point_size))
        if clamped == self._font_size:
            return
        self._font_size = clamped
        self._ansi.font_size = clamped
        mono = pick_mono_font(clamped)
        self.setFont(mono)
        self.setCursorWidth(max(self.fontMetrics().horizontalAdvance("M"), 8))

        cur = QTextCursor(self.document())
        cur.select(QTextCursor.SelectionType.Document)
        fmt = QTextCharFormat()
        fmt.setFontPointSize(clamped)
        cur.mergeCharFormat(fmt)

        for _bn, _sc, _ol, hbtn in self._help_buttons:
            hbtn.setFont(mono)
            hbtn.adjustSize()
        self._apply_ui_scale()
        self._reposition_prompt_buttons()
        self._show_toast(f"{clamped} pt")
        self.font_size_changed.emit(clamped)

    def wheelEvent(self, event) -> None:  # noqa: N802
        if event.modifiers() & Qt.KeyboardModifier.ControlModifier:
            delta = event.angleDelta().y()
            if delta > 0:
                self.set_font_size(self._font_size + 1)
            elif delta < 0:
                self.set_font_size(self._font_size - 1)
            event.accept()
            return
        super().wheelEvent(event)

    def insertFromMimeData(self, source) -> None:  # noqa: N802
        if source is not None and source.hasText():
            self.input_bytes.emit(source.text().encode("utf-8", errors="replace"))

    def inputMethodEvent(self, event) -> None:  # noqa: N802
        text = event.commitString()
        if text:
            self.input_bytes.emit(text.encode("utf-8", errors="replace"))
        event.accept()

    def keyPressEvent(self, event: QKeyEvent) -> None:  # noqa: N802
        self.activity.emit(int(event.key()))
        if event.modifiers() & Qt.KeyboardModifier.ControlModifier:
            if event.key() == Qt.Key.Key_F:
                self.show_search()
                return
            if event.key() == Qt.Key.Key_S:
                self.save_output()
                return
            if event.key() in (Qt.Key.Key_Plus, Qt.Key.Key_Equal):
                self.set_font_size(self._font_size + 1)
                return
            if event.key() == Qt.Key.Key_Minus:
                self.set_font_size(self._font_size - 1)
                return
            if event.key() == Qt.Key.Key_0:
                self.set_font_size(FONT_POINT_SIZE)
                return
            ctrl_shift = bool(event.modifiers() & Qt.KeyboardModifier.ShiftModifier)
            if event.key() == Qt.Key.Key_V:
                self._paste_from_clipboard()
                return
            if event.key() == Qt.Key.Key_C and (ctrl_shift or self.textCursor().hasSelection()):
                # Ctrl+C copies when text is selected (or with Shift); otherwise it is SIGINT.
                self.copy()
                return
        if self._active_prompt_block is not None and self._active_options:
            count = len(self._active_options)
            if event.key() == Qt.Key.Key_Right:
                if self._selected_opt_idx is None:
                    if self._active_default_opt in self._active_options:
                        self._selected_opt_idx = self._active_options.index(self._active_default_opt)
                    else:
                        self._selected_opt_idx = 0
                else:
                    self._selected_opt_idx = (self._selected_opt_idx + 1) % count
                self._restyle_prompt_chips()
                return
            if event.key() == Qt.Key.Key_Left:
                if self._selected_opt_idx is None:
                    if self._active_default_opt in self._active_options:
                        self._selected_opt_idx = self._active_options.index(self._active_default_opt)
                    else:
                        self._selected_opt_idx = count - 1
                else:
                    self._selected_opt_idx = (self._selected_opt_idx - 1) % count
                self._restyle_prompt_chips()
                return
            if event.key() == Qt.Key.Key_Escape and self._selected_opt_idx is not None:
                self._selected_opt_idx = None
                self._restyle_prompt_chips()
                return
            if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter) and self._selected_opt_idx is not None:
                self._scroll_to_bottom()
                opt = self._active_options[self._selected_opt_idx]
                if opt == "__confirm__":
                    self.prompt_confirm_clicked.emit()
                elif opt == "__cancel__":
                    self.prompt_clear_clicked.emit()
                else:
                    self.prompt_option_submitted.emit(opt)
                return
        if event.key() in (
            Qt.Key.Key_Up,
            Qt.Key.Key_Down,
            Qt.Key.Key_Left,
            Qt.Key.Key_Right,
            Qt.Key.Key_Home,
            Qt.Key.Key_End,
            Qt.Key.Key_PageUp,
            Qt.Key.Key_PageDown,
        ):
            self._snap_cursor_to_input()
            if self._is_canonical():
                return
            seq_map = {
                Qt.Key.Key_Up: b"\x1b[A",
                Qt.Key.Key_Down: b"\x1b[B",
                Qt.Key.Key_Right: b"\x1b[C",
                Qt.Key.Key_Left: b"\x1b[D",
                Qt.Key.Key_Home: b"\x1b[H",
                Qt.Key.Key_End: b"\x1b[F",
                Qt.Key.Key_PageUp: b"\x1b[5~",
                Qt.Key.Key_PageDown: b"\x1b[6~",
            }
            self.input_bytes.emit(seq_map[event.key()])
            return
        if event.key() in (Qt.Key.Key_C,) and event.modifiers() & Qt.KeyboardModifier.ControlModifier:
            self._scroll_to_bottom()  # like a terminal: typing jumps back to the live output
            self._snap_cursor_to_input()
            self.input_bytes.emit(b"\x03")
            return
        if event.key() == Qt.Key.Key_Backspace:
            self._scroll_to_bottom()
            self._snap_cursor_to_input()
            self.input_bytes.emit(b"\x7f")
            return
        if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
            # Ignore Enter while no prompt is waiting, so mashing it during a
            # non-interactive step does not scroll blank lines into the output.
            if not self._enter_wanted():
                return
            self._scroll_to_bottom()
            self._snap_cursor_to_input()
            self.input_bytes.emit(b"\r")
            return
        if event.key() == Qt.Key.Key_Tab:
            self._scroll_to_bottom()
            self._snap_cursor_to_input()
            self.input_bytes.emit(b"\t")
            return
        if event.key() in (Qt.Key.Key_Escape, Qt.Key.Key_Delete, Qt.Key.Key_Insert) or (
            Qt.Key.Key_F1 <= event.key() <= Qt.Key.Key_F35
        ):
            return
        text = "".join(ch for ch in event.text() if ch >= " " and ord(ch) != 0x7F)
        if text:
            self._scroll_to_bottom()
            self._snap_cursor_to_input()
            self.input_bytes.emit(text.encode("utf-8", errors="replace"))
            return
        return

    def _position_scroll_bottom_button(self) -> None:
        vp = self.viewport()
        margin = 14
        x = max(margin, vp.width() - self._scroll_bottom_btn.width() - margin)
        y = max(margin, vp.height() - self._scroll_bottom_btn.height() - margin)
        self._scroll_bottom_btn.move(x, y)
        self._scroll_bottom_btn.raise_()

    def _update_scroll_bottom_button(self) -> None:
        vbar = self.verticalScrollBar()
        should_show = (not self._follow_tail) and vbar.maximum() > 0
        if should_show != self._scroll_bottom_btn.isVisible():
            self._scroll_bottom_btn.setVisible(should_show)
        if should_show:
            self._position_scroll_bottom_button()

    def _scroll_to_bottom(self) -> None:
        self._follow_tail = True
        self._updating_scroll = True
        try:
            vbar = self.verticalScrollBar()
            vbar.setValue(vbar.maximum())
        finally:
            self._updating_scroll = False
        self._update_scroll_bottom_button()

    def _is_at_bottom(self) -> bool:
        vbar = self.verticalScrollBar()
        return vbar.value() >= max(0, vbar.maximum() - 2)

    def _on_scroll_changed(self, _value: int) -> None:
        if not self._updating_scroll:
            self._follow_tail = self._is_at_bottom()
        self._update_scroll_bottom_button()

    def _on_range_changed(self, _min: int, max_val: int) -> None:
        if self._follow_tail:
            self._updating_scroll = True
            try:
                self.verticalScrollBar().setValue(max_val)
            finally:
                self._updating_scroll = False
        self._update_scroll_bottom_button()

    def feed(self, data: bytes) -> None:
        if self._utf8_pending:
            data = self._utf8_pending + data
            self._utf8_pending = b""
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError as exc:
            # Keep incomplete trailing sequence for the next chunk.
            valid = data[: exc.start]
            self._utf8_pending = data[exc.start :]
            text = valid.decode("utf-8", errors="replace")
        self._updating_scroll = True
        edit = QTextCursor(self.document())
        try:
            edit.beginEditBlock()  # one relayout/signal batch for the whole chunk
            try:
                self._consume_text(text)
            finally:
                edit.endEditBlock()
            if self._follow_tail:
                self._snap_cursor_to_input()
                vbar = self.verticalScrollBar()
                vbar.setValue(vbar.maximum())
        finally:
            self._updating_scroll = False

    def has_line(self, texts: tuple[str, ...]) -> bool:
        block = self.document().firstBlock()
        while block.isValid():
            if block.text().strip() in texts:
                return True
            block = block.next()
        return False

    def declined_prompt(self) -> bool:
        """True if the last answered y/n-style prompt got a negative answer (user chose to stop).

        Only counts when little output follows it, so a "no" early in a long run
        that later failed for another reason is still reported as a failure.
        """
        block = self.document().lastBlock()
        lines_after = 0
        while block.isValid():
            text = block.text().rstrip()
            m = _ANSWERED_PROMPT_RE.match(text)
            if m and "/" in m.group(2):
                options = [o.strip().lower() for o in m.group(2).split("/")]
                answer = m.group(3).lower()
                negative = answer in NEGATIVE_ANSWERS or (
                    answer == "a" and "r" in options and "i" in options  # Abort/Retry/Ignore
                )
                return negative and lines_after <= DECLINE_TRAILING_LINES
            if text.strip():
                lines_after += 1
            block = block.previous()
        return False

    def remove_lines(self, texts: tuple[str, ...]) -> None:
        """Delete finished lines whose text equals one of ``texts`` (plus the blank line after each)."""
        doc = self.document()
        last = doc.lastBlock().blockNumber()
        edit = QTextCursor(doc)
        edit.beginEditBlock()
        try:
            block = doc.firstBlock()
            while block.isValid() and block.blockNumber() < last:
                if block.text().strip() in texts:
                    num = block.blockNumber()
                    nxt = block.next()
                    end = block.position() + block.length()
                    if nxt.isValid() and nxt.blockNumber() < last and not nxt.text().strip():
                        end += nxt.length()
                    cur = QTextCursor(doc)
                    cur.setPosition(block.position())
                    cur.setPosition(min(end, doc.characterCount() - 1), QTextCursor.MoveMode.KeepAnchor)
                    cur.removeSelectedText()
                    last = doc.lastBlock().blockNumber()
                    block = doc.findBlockByNumber(num)
                    continue
                block = block.next()
        finally:
            edit.endEditBlock()

    def _consume_text(self, text: str) -> None:
        # Plain characters are accumulated and written in one document edit per
        # run; any control/escape handling flushes the run first so ordering and
        # the active SGR format are preserved.
        run: list[str] = []

        def flush() -> None:
            if run:
                self._write_chars("".join(run), self._ansi.char_format())
                run.clear()

        for ch in text:
            if self._in_csi:
                self._csi_buf += ch
                # CSI final byte is in 0x40-0x7E.
                if "@" <= ch <= "~":
                    flush()
                    self._handle_csi(self._csi_buf)
                    self._csi_buf = ""
                    self._in_csi = False
                    self._in_esc = False
                continue
            if self._in_esc:
                if ch == "[":
                    self._in_csi = True
                    self._csi_buf = ""
                elif ch == "]":
                    # OSC: swallow until BEL or ST — do not print/control.
                    self._in_esc = False
                    self._in_osc = True
                    self._osc_buf = ""
                else:
                    # Unsupported short escape: drop introducer only.
                    self._in_esc = False
                continue
            if getattr(self, "_in_osc", False):
                if ch == "\a" or ch == "\x1b":
                    self._in_osc = False
                    self._osc_buf = ""
                    if ch == "\x1b":
                        self._in_esc = True
                else:
                    self._osc_buf = getattr(self, "_osc_buf", "") + ch
                continue
            if ch == "\x1b":
                flush()
                self._in_esc = True
                continue
            if ch == "\r":
                flush()
                self._carriage_return()
                continue
            if ch == "\b":
                flush()
                self._backspace()
                continue
            if ch == "\n":
                flush()
                self._write_newline()
                continue
            if ch == "\a":
                continue
            run.append(ch)
        flush()

    def _handle_csi(self, body: str) -> None:
        if not body:
            return
        final = body[-1]
        params_str = body[:-1]
        params: list[int] = []
        if params_str:
            for part in params_str.split(";"):
                if part == "":
                    params.append(0)
                else:
                    try:
                        params.append(int(part))
                    except ValueError:
                        params.append(0)

        # Scrollback is append-only: never honor clear-screen / cursor-up /
        # delete-lines that would wipe previous upgrade output. Only SGR and
        # last-line edits (K / G / C / D) are applied.
        if final == "m":
            self._ansi.apply_sgr(params)
        elif final == "K":
            mode = params[0] if params else 0
            self._erase_in_last_line(mode)
        elif final == "G":
            col = max((params[0] if params else 1), 1)
            self._move_in_last_line(col)
        elif final == "C":
            n = params[0] if params else 1
            self._nudge_in_last_line(n)
        elif final == "D":
            n = params[0] if params else 1
            self._nudge_in_last_line(-n)
        # Intentionally ignored: J (erase display), H/f (cursor position),
        # A/B (cursor up/down), M/L (delete/insert lines), etc.

    def _last_block_cursor(self) -> QTextCursor:
        cursor = QTextCursor(self.document())
        cursor.movePosition(QTextCursor.MoveOperation.End)
        return cursor

    def _write_newline(self) -> None:
        cursor = self._last_block_cursor()
        cursor.setCharFormat(self._ansi.char_format())
        cursor.insertText("\n")
        self._line_col = 0

    def _write_chars(self, text: str, fmt: QTextCharFormat) -> None:
        """Write into the last line; overwrite after CR instead of inserting."""
        cursor = self._last_block_cursor()
        block = cursor.block()
        col = getattr(self, "_line_col", len(block.text()))
        col = max(0, min(col, len(block.text())))
        cursor.setPosition(block.position() + col)

        remaining = len(block.text()) - col
        replace_n = min(len(text), max(remaining, 0))
        if replace_n:
            cursor.movePosition(
                QTextCursor.MoveOperation.Right,
                QTextCursor.MoveMode.KeepAnchor,
                n=replace_n,
            )
            cursor.removeSelectedText()
        cursor.setCharFormat(fmt)
        cursor.insertText(text)
        self._line_col = col + len(text)

    def _carriage_return(self) -> None:
        # Only affects the current (last) line — keeps history intact.
        self._line_col = 0

    def _backspace(self) -> None:
        col = getattr(self, "_line_col", 0)
        if col <= 0:
            return
        cursor = self._last_block_cursor()
        block = cursor.block()
        cursor.setPosition(block.position() + col)
        cursor.deletePreviousChar()
        self._line_col = col - 1

    def _erase_in_last_line(self, mode: int) -> None:
        cursor = self._last_block_cursor()
        block = cursor.block()
        col = getattr(self, "_line_col", len(block.text()))
        col = max(0, min(col, len(block.text())))
        if mode == 1:
            cursor.setPosition(block.position())
            cursor.setPosition(block.position() + col, QTextCursor.MoveMode.KeepAnchor)
            cursor.removeSelectedText()
            self._line_col = 0
        elif mode == 2:
            cursor.setPosition(block.position())
            cursor.movePosition(QTextCursor.MoveOperation.EndOfBlock, QTextCursor.MoveMode.KeepAnchor)
            cursor.removeSelectedText()
            self._line_col = 0
        else:
            cursor.setPosition(block.position() + col)
            cursor.movePosition(QTextCursor.MoveOperation.EndOfBlock, QTextCursor.MoveMode.KeepAnchor)
            cursor.removeSelectedText()

    def _move_in_last_line(self, col: int) -> None:
        cursor = self._last_block_cursor()
        block = cursor.block()
        target = min(max(col - 1, 0), len(block.text()))
        self._line_col = target

    def _nudge_in_last_line(self, delta: int) -> None:
        cursor = self._last_block_cursor()
        block = cursor.block()
        col = getattr(self, "_line_col", len(block.text()))
        col = max(0, min(col + delta, len(block.text())))
        self._line_col = col


_PROMPT_RE = re.compile(r"^(.*?)\[([^\[\]\n]+)\](?:\s*\(([^()\n]+)\))?\s*[:?]\s*$")
_ANSWERED_PROMPT_RE = re.compile(r"^(.*?)\[([^\[\]\n]+)\](?:\s*\([^()\n]+\))?\s*[:?]\s*(\S+)$")
NEGATIVE_ANSWERS = ("n", "no", "não", "nein")
DECLINE_TRAILING_LINES = 6  # max non-blank lines after a declined prompt
_HELP_OPT_RE = re.compile(r"^\s*(#\d+\s*:\s*([^\s]+))\s+-\s+.+$")


def resolve_app_icon(widget: QWidget | None = None) -> QIcon:
    """Return the updater theme icon, falling back to a standard Qt icon."""
    icon = QIcon.fromTheme("system-software-update")
    if not icon.isNull():
        return icon
    icon = QIcon.fromTheme("software-update-available")
    if not icon.isNull():
        return icon
    style = widget.style() if widget is not None else QApplication.style()
    if style is not None:
        return style.standardIcon(QStyle.StandardPixmap.SP_ComputerIcon)
    return QIcon()


def option_button_label(opt: str, options: list[str]) -> str:
    """Map a Zypper prompt option token to a human-readable localized button label."""
    low = opt.lower()
    if low.isdigit():
        return tr("opt_solution", n=opt)
    if low == "?":
        return tr("opt_all")
    if low in ("y", "yes", "j", "ja", "sim", "sí"):
        return tr("opt_yes")
    if low in ("n", "no", "não", "nein"):
        return tr("opt_no")
    if low == "s":
        if "n" in options or "no" in options or "não" in options:
            return tr("opt_yes")
        if any(o.isdigit() for o in options):
            return tr("opt_skip")
    if low == "r" and any(o.isdigit() for o in options):
        return tr("opt_retry")
    if low == "v":
        return tr("opt_view")
    if low == "d":
        return tr("opt_details")
    if low == "c":
        return tr("opt_cancel")
    if "i" in options and low in ("a", "r", "i"):
        return {"a": tr("opt_abort"), "r": tr("opt_retry"), "i": tr("opt_ignore")}[low]
    if "t" in options and low in ("r", "t", "a"):
        return {"r": tr("opt_reject"), "t": tr("opt_trust_temp"), "a": tr("opt_trust_always")}[low]
    return opt


def parse_zypper_prompt(line: str) -> tuple[str, list[str], str | None] | None:
    """Extract (question, options, default) from an interactive Zypper prompt line."""
    stripped = line.rstrip()
    if not stripped:
        return None
    match = _PROMPT_RE.match(stripped)
    if not match:
        return None
    question_part, bracket_part, default_part = match.groups()
    if "/" not in bracket_part:
        return None

    options: list[str] = []
    seen: set[str] = set()
    for raw in bracket_part.split("/"):
        tok = raw.strip()
        if not tok:
            continue
        if tok.startswith("..."):
            # Zypper uses "...? shows all options" (or localized equivalent) as a tail hint.
            if "?" in tok and "?" not in seen:
                options.append("?")
                seen.add("?")
            continue
        if len(tok) > 16 or any(ch.isspace() for ch in tok):
            return None
        if tok not in seen:
            options.append(tok)
            seen.add(tok)

    if len(options) < 2:
        return None

    default_opt = default_part.strip() if default_part else None
    if default_opt and default_opt not in seen:
        default_opt = None
    question = question_part.strip() or stripped
    return question, options, default_opt


_NOTIFY_IFACE = "org.freedesktop.Notifications"
_CONTINUE_PROMPT_RE = re.compile(
    r"^\s*(continue|continuar|continuer|fortfahren|続行)\b", re.IGNORECASE
)


def is_continue_question(question: str) -> bool:
    """True for the generic zypper "Continue? [y/n/...]" confirmation."""
    return bool(_CONTINUE_PROMPT_RE.match(question))


class PromptNotifier(QObject):
    """Persistent desktop notification that focuses the window when clicked.

    Uses dbus-python with a GLib loop in a daemon thread (same approach as
    update-viewer); results come back to the Qt thread through signals.
    """

    activated = pyqtSignal(str)  # XDG activation token (may be empty)

    def __init__(self, parent: QObject | None = None) -> None:
        super().__init__(parent)
        self._iface = None
        self._id = 0
        self._token = ""
        self._lock = threading.Lock()
        try:
            import dbus
            from dbus.mainloop.glib import DBusGMainLoop
            from gi.repository import GLib

            DBusGMainLoop(set_as_default=True)
            bus = dbus.SessionBus()
            proxy = bus.get_object(_NOTIFY_IFACE, "/org/freedesktop/Notifications")
            self._iface = dbus.Interface(proxy, _NOTIFY_IFACE)
            bus.add_signal_receiver(
                self._on_action, "ActionInvoked", _NOTIFY_IFACE, path="/org/freedesktop/Notifications"
            )
            bus.add_signal_receiver(
                self._on_token, "ActivationToken", _NOTIFY_IFACE, path="/org/freedesktop/Notifications"
            )
            loop = GLib.MainLoop()
            threading.Thread(target=loop.run, name="DBus-GLib-Loop", daemon=True).start()
            self._dbus = dbus
        except Exception:  # noqa: BLE001 - notifications are best effort
            self._iface = None

    def show(self, summary: str, body: str, action_label: str) -> None:
        if self._iface is None:
            return
        dbus = self._dbus
        try:
            # expire_timeout 0 + critical urgency: the notification never expires.
            new_id = int(
                self._iface.Notify(
                    "update-console",
                    dbus.UInt32(self._id),
                    "system-software-update",
                    summary,
                    body,
                    dbus.Array(["default", action_label], signature="s"),
                    dbus.Dictionary(
                        {"urgency": dbus.Byte(2), "resident": True},
                        signature="sv",
                    ),
                    dbus.Int32(0),
                )
            )
            with self._lock:
                self._id = new_id
        except Exception:  # noqa: BLE001
            pass

    def close(self) -> None:
        with self._lock:
            nid, self._id = self._id, 0
        if nid and self._iface is not None:
            try:
                self._iface.CloseNotification(self._dbus.UInt32(nid))
            except Exception:  # noqa: BLE001
                pass

    def _on_token(self, nid, token) -> None:  # GLib thread
        if int(nid) == self._id:
            self._token = str(token)

    def _on_action(self, nid, action) -> None:  # GLib thread
        if int(nid) == self._id and str(action) == "default":
            token, self._token = self._token, ""
            self.activated.emit(token)


class UpdateConsoleWindow(QMainWindow):
    def __init__(self) -> None:
        super().__init__()
        self.setWindowTitle(window_title())
        self.setWindowIcon(resolve_app_icon(self))
        self._session: PtySession | None = None
        self._awaiting_exit = False
        self._active_prompt_sig: tuple[int, tuple[str, ...]] | None = None
        self._notified_prompt_sig: tuple[int, tuple[str, ...]] | None = None
        self._notifier = PromptNotifier(self)
        self._notifier.activated.connect(self._bring_to_front)
        self._typed_shortcut = ""
        self._prompt_block_num: int | None = None
        self._prompt_base_text: str | None = None
        self._confirm_mode = False
        self._got_output = False
        self._closing = False  # shutdown of the running upgrade in progress
        self._close_ready = False  # closeEvent may now accept
        self._shutdown_waiting = False  # signals sent, still waiting for the upgrade to end
        self._auto_close_active = False  # authentication-cancelled countdown running
        self._user_interrupted = False  # the user sent Ctrl+C to the upgrade

        self._stop_timer = QTimer(self)  # grace period before escalating to SIGHUP
        self._stop_timer.setSingleShot(True)
        self._stop_timer.timeout.connect(self._escalate_shutdown)

        self._prompt_timer = QTimer(self)
        self._prompt_timer.setSingleShot(True)
        self._prompt_timer.setInterval(80)
        self._prompt_timer.timeout.connect(self._check_for_prompt)

        central = QWidget(self)
        layout = QVBoxLayout(central)
        layout.setContentsMargins(0, 0, 0, 0)
        self.view = ConsoleView(central)
        layout.addWidget(self.view)

        self.setCentralWidget(central)
        self.setStyleSheet(f"QMainWindow {{ background-color: {DEFAULT_BG}; }}")

        self.view.input_bytes.connect(self._on_input)
        self.view.prompt_option_clicked.connect(self._type_prompt_shortcut)
        self.view.prompt_option_submitted.connect(self._submit_prompt_option)
        self.view.prompt_confirm_clicked.connect(self._confirm_prompt)
        self.view.prompt_clear_clicked.connect(self._clear_prompt_input)
        self.view.font_size_changed.connect(self._sync_winsize)
        self.view.activity.connect(self._on_activity)
        QTimer.singleShot(0, self._start_session)

    def showEvent(self, event) -> None:  # noqa: N802
        super().showEvent(event)
        self.showMaximized()
        self.view.setFocus(Qt.FocusReason.ActiveWindowFocusReason)

    def closeEvent(self, event) -> None:  # noqa: N802
        running = self._session is not None and self._session.is_running()
        if self._close_ready or not running:
            self._notifier.close()
            self._prompt_timer.stop()
            self._stop_timer.stop()
            super().closeEvent(event)
            return
        event.ignore()  # the window closes once the upgrade has really stopped
        if self._closing:
            if self._shutdown_waiting:
                # The user insisted: leave the upgrade running in the background.
                QTimer.singleShot(0, self._finish_close)
            return
        if self._got_output and not self._awaiting_exit:
            answer = QMessageBox.warning(
                self,
                tr("close_title"),
                tr("close_body"),
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No,
            )
            if answer != QMessageBox.StandardButton.Yes:
                return
        self._begin_shutdown()

    def _begin_shutdown(self) -> None:
        """Ask the upgrade to abort (Ctrl+C) without blocking the event loop."""
        self._closing = True
        self._awaiting_exit = True  # stop forwarding input to the PTY
        self._prompt_timer.stop()
        self._clear_active_prompt()
        self.view.feed(f"\n\x1b[1;33m● {tr('stopping')}\x1b[0m\n".encode("utf-8"))
        self._session.interrupt()
        self._stop_timer.start(int(TERMINATE_GRACE_S * 1000))

    def _escalate_shutdown(self) -> None:
        if self._session is not None and self._session.is_running():
            self._session.hangup()
            QTimer.singleShot(1000, self._after_hangup)
        else:
            self._finish_close()

    def _after_hangup(self) -> None:
        if self._session is None or not self._session.is_running():
            self._finish_close()
            return
        self._session.kill_fallback()
        # zypper may be finishing the current package: keep the window and wait for
        # _on_exited instead of orphaning a root process silently.
        self._shutdown_waiting = True
        self.view.feed(f"\x1b[1;33m● {tr('stopping_wait')}\x1b[0m\n".encode("utf-8"))

    def _finish_close(self) -> None:
        self._stop_timer.stop()
        self._close_ready = True
        self.close()

    def resizeEvent(self, event) -> None:  # noqa: N802
        super().resizeEvent(event)
        self._sync_winsize()

    def _start_session(self) -> None:
        argv = ["/usr/bin/pkexec", UPDATE_SYSTEM, "--root", "--console"]
        if not os.path.isfile(UPDATE_SYSTEM):
            # Dev / unpackaged fallback
            here = os.path.abspath(os.path.join(os.path.dirname(__file__), "update-system"))
            if os.path.isfile(here):
                argv = ["/usr/bin/pkexec", here, "--root", "--console"]
        self._got_output = False
        self._waiting_text = f"● {tr('auth_waiting')}"
        self._session = PtySession(argv, self)
        self.view._is_canonical = self._session.is_canonical
        self.view._enter_wanted = self._enter_wanted
        self._session.output.connect(self._on_pty_output)
        self._session.exited.connect(self._on_exited)
        self._sync_winsize()
        self.view.feed(f"\x1b[1;36m●\x1b[0m \x1b[2m{tr('auth_waiting')}\x1b[0m\n\n".encode("utf-8"))

    def _on_pty_output(self, data: bytes) -> None:
        if not self._got_output:
            # First output: pkexec auth is over (or failed); drop the waiting hint.
            self._got_output = True
            self.view.remove_lines((self._waiting_text,))
        self.view.feed(data)
        if b"\n" in data:
            self._clear_active_prompt()
        else:
            self.view._reposition_prompt_buttons()
        self._prompt_timer.start()

    def _bring_to_front(self, token: str = "") -> None:
        if token:
            os.environ["XDG_ACTIVATION_TOKEN"] = token
        if self.isMinimized():
            self.showNormal()
        self.raise_()
        self.activateWindow()
        handle = self.windowHandle()
        if handle is not None:
            handle.requestActivate()
        self.view.setFocus(Qt.FocusReason.ActiveWindowFocusReason)

    def _clear_active_prompt(self) -> None:
        self._notifier.close()
        self._active_prompt_sig = None
        self._typed_shortcut = ""
        self._prompt_block_num = None
        self._prompt_base_text = None
        self._confirm_mode = False
        self.view.clear_inline_prompt_links()

    def _type_prompt_shortcut(self, option: str) -> None:
        if self._session is None or self._awaiting_exit:
            return
        erase = b"\x7f" * len(self._typed_shortcut)
        self._typed_shortcut = option
        self._confirm_mode = True
        self.view.show_confirm_cancel_buttons(option)
        self._session.write(erase + option.encode("utf-8"))
        self.view.setFocus(Qt.FocusReason.OtherFocusReason)

    def _confirm_prompt(self) -> None:
        if self._session is None or self._awaiting_exit:
            return
        self._clear_active_prompt()
        self._session.write(b"\r")
        self.view.setFocus(Qt.FocusReason.OtherFocusReason)

    def _clear_prompt_input(self) -> None:
        if self._session is None or self._awaiting_exit:
            return
        last_text = self.view.document().lastBlock().text().rstrip()
        typed_len = 0
        if self._prompt_base_text and last_text.startswith(self._prompt_base_text):
            typed_len = len(last_text[len(self._prompt_base_text) :].strip())
        typed_len = max(typed_len, len(self._typed_shortcut), 1)
        self._typed_shortcut = ""
        self._active_prompt_sig = None
        self._session.write(b"\x7f" * typed_len)
        self.view.setFocus(Qt.FocusReason.OtherFocusReason)

    def _submit_prompt_option(self, option: str) -> None:
        if self._session is None or self._awaiting_exit:
            return
        erase = b"\x7f" * len(self._typed_shortcut)
        self._clear_active_prompt()
        self._session.write(erase + f"{option}\n".encode("utf-8"))
        self.view.setFocus(Qt.FocusReason.OtherFocusReason)

    def _check_for_prompt(self) -> None:
        if self._awaiting_exit:
            return
        doc = self.view.document()
        last_block = doc.lastBlock()
        parsed = parse_zypper_prompt(last_block.text())
        if parsed is not None:
            _question, options, default_opt = parsed
            sig = (doc.blockCount(), tuple(options))
            if sig != self._active_prompt_sig or self._confirm_mode:
                self._active_prompt_sig = sig
                self._prompt_block_num = last_block.blockNumber()
                self._prompt_base_text = last_block.text().rstrip()
                self._confirm_mode = False
                self.view.set_inline_prompt_links(options, default_opt)

            if sig != self._notified_prompt_sig and not self.isActiveWindow():
                self._notified_prompt_sig = sig
                question = _question.strip()
                body = (
                    tr("prompt_notify_continue")
                    if is_continue_question(question)
                    else tr("prompt_notify", question=last_block.text().strip())
                )
                self._notifier.show(tr("window_title"), body, tr("notify_action_open"))
                # Fallback for when D-Bus notifications are unavailable.
                QApplication.alert(self)
            return

        if (
            self._prompt_block_num == last_block.blockNumber()
            and self._prompt_base_text is not None
        ):
            tail = last_block.text().rstrip()
            if tail.startswith(self._prompt_base_text) and len(tail) > len(self._prompt_base_text):
                typed = tail[len(self._prompt_base_text) :].strip()
                if not self._confirm_mode:
                    self._confirm_mode = True
                    self.view.show_confirm_cancel_buttons(typed or None)

    def _sync_winsize(self) -> None:
        if self._session is None:
            return
        metrics = self.view.fontMetrics()
        char_w = max(metrics.horizontalAdvance("M"), 1)
        char_h = max(metrics.lineSpacing(), 1)
        cols = max(int(self.view.viewport().width() / char_w), 20)
        rows = max(int(self.view.viewport().height() / char_h), 5)
        self._session.set_winsize(rows, cols)

    def _enter_wanted(self) -> bool:
        """Enter is only meaningful at a prompt, at a hidden-input (password) read or to close."""
        if self._awaiting_exit:
            return True
        if self._session is None:
            return False
        if self._active_prompt_sig is not None or self._confirm_mode or self._typed_shortcut:
            return True
        return self._session.is_echo_off()

    def _on_input(self, data: bytes) -> None:
        if self._awaiting_exit:
            if b"\r" in data or b"\n" in data:
                self.close()
            return
        if b"\x03" in data:
            self._user_interrupted = True
        if b"\r" in data or b"\n" in data or b"\x03" in data:
            self._clear_active_prompt()
        elif data in (b"\x7f", b"\x08"):
            self._typed_shortcut = self._typed_shortcut[:-1]
        else:
            self._typed_shortcut = ""
        if self._session is not None:
            self._session.write(data)

    def _poll_update_viewer(self) -> None:
        """Ask update-viewer to re-check; runs in a thread so the window never blocks."""

        def run() -> None:
            try:
                subprocess.run(
                    [
                        "timeout",
                        "3",
                        "dbus-send",
                        "--session",
                        "--type=method_call",
                        "--dest=org.updateViewer",
                        "/org/updateViewer",
                        "org.updateViewer.Manager.poll_updates",
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
            except Exception:  # noqa: BLE001 - best effort
                pass

        threading.Thread(target=run, name="poll-update-viewer", daemon=True).start()

    def _on_exited(self, code: int) -> None:
        # --root ends after the upgrade; prompt locally (like wait_for_enter).
        self._prompt_timer.stop()
        self._clear_active_prompt()
        self._awaiting_exit = True  # before anything slow: input now only means "close"
        if self._closing:
            self._finish_close()
            return
        self._poll_update_viewer()
        self.view.remove_lines((self._waiting_text,))
        # 126 is pkexec's "not authorized / dismissed". 127 is also "command not found" or
        # "no polkit agent", so only treat it as a cancelled login when pkexec printed its
        # known "Not authorized" noise or nothing at all; otherwise show the real error.
        is_auth_cancel = code in PKEXEC_AUTH_FAILURE_CODES and (
            code == 126 or not self._got_output or self.view.has_line(PKEXEC_NOISE_LINES)
        )
        if is_auth_cancel:
            self.view.remove_lines(PKEXEC_NOISE_LINES)
            self.view.feed(
                f"\n  \x1b[1;31m✗ {tr('auth_title')}\x1b[0m\n    \x1b[1;97m{tr('auth_body')}\x1b[0m\n".encode("utf-8")
            )
            self._awaiting_exit = True
            self._auto_close_left = AUTH_AUTO_CLOSE_SECONDS
            self._auto_close_active = True
            self._auto_close_tick(first=True)
            return
        if code == 0:
            mark, color, text = "✓", "1;32", tr("final_ok")
        elif code in ZYPPER_SIGNAL_CODES or self._user_interrupted or self.view.declined_prompt():
            # The user chose to stop (answered no / pressed Ctrl+C): zypper exits
            # non-zero (105 at a prompt, 8 while committing), but that is not a failure.
            mark, color, text = "⚠", "1;33", tr("final_cancelled")
        else:
            mark, color, text = "✗", "1;31", tr("final_fail", code=code)
        self.setWindowTitle(f"{mark} {window_title()}")
        self.view.feed(f"\n\x1b[{color}m{mark} {text}\x1b[0m\n".encode("utf-8"))
        hint = exit_hint(code) if mark == "✗" else None
        if hint:
            self.view.feed(f"  \x1b[2m{hint}\x1b[0m\n".encode("utf-8"))
        self.view.feed(tr("press_enter").encode("utf-8"))
        self._awaiting_exit = True
        if not self.isActiveWindow():
            QApplication.alert(self)  # flash the taskbar entry: the update is over

    def _on_activity(self, key: int) -> None:
        """Any key except Enter cancels the countdown and keeps the window open."""
        if not self._auto_close_active or key in (int(Qt.Key.Key_Return), int(Qt.Key.Key_Enter)):
            return
        self._auto_close_active = False
        self.view.feed(("\r\x1b[2K" + tr("press_enter")).encode("utf-8"))

    def _auto_close_tick(self, first: bool = False) -> None:
        """Rewrite the countdown line in place, then close the window at zero."""
        if not self._auto_close_active:
            return
        if self._auto_close_left <= 0:
            self.close()
            return
        prefix = "\n" if first else "\r\x1b[2K"
        self.view.feed(f"{prefix}\x1b[1;97m{tr('auth_closing', n=self._auto_close_left)}\x1b[0m".encode("utf-8"))
        self._auto_close_left -= 1
        QTimer.singleShot(1000, self._auto_close_tick)


# pkexec exit codes: 126 = not authorized, 127 = dialog dismissed or not shown.
PKEXEC_AUTH_FAILURE_CODES = (126, 127)
# zypper 105 (killed by a signal): what Ctrl+C at a prompt really produces (measured).
# 130 (shell died of SIGINT) is a defensive guess for Ctrl+C when no zypper is running.
ZYPPER_SIGNAL_CODES = (105, 130)
AUTH_AUTO_CLOSE_SECONDS = 5
# Untranslated pkexec output replaced by our own message on those codes.
PKEXEC_NOISE_LINES = (
    "Error executing command as another user: Not authorized",
    "This incident has been reported.",
)


def main() -> int:
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass

    app = QApplication(sys.argv)
    app.setApplicationName("update-console")
    app.setWindowIcon(resolve_app_icon())
    window = UpdateConsoleWindow()
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
