    def format_time(self, seconds):
        """ Formata o tempo para horas, minutos e segundos. """
        hours, remainder = divmod(seconds, 3600)
        minutes, seconds = divmod(remainder, 60)
        time_str = []
        if hours > 0:
            time_str.append(f"{int(hours)}h")
        if minutes > 0:
            time_str.append(f"{int(minutes)}m")
        time_str.append(f"{int(seconds)}s")
        return " ".join(time_str)

    def format_size(self, size_in_bytes):
        for unit in ['bytes', 'KB', 'MB', 'GB', 'TB']:
            if size_in_bytes < 1024:
                return f"{size_in_bytes:.2f} {unit}"
            size_in_bytes /= 1024


def run_repo_check():
    try:
        result = subprocess.run(
            ["zypper", "--xmlout", "repos", "-u"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True
        )
        return result.stdout.decode('utf-8')
    except subprocess.CalledProcessError as e:
        print(f"Erro ao obter repositórios: {e.stderr.decode('utf-8')}", file=sys.stderr)
        return None


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)

    default_update_checker_files_directory = DEFAULT_UPDATE_CHECKER_FILES_DIRECTORY
    default_run_log_file_path = DEFAULT_RUN_LOG_FILE_PATH
    default_xml_file_path = DEFAULT_XML_FILE_PATH

    # Se informado, lê o arquivo XML, a partir do primeiro argumento de linha de comando
    # e salva na variável xml_output
    xml_file = sys.argv[1] if len(sys.argv) > 1 else default_xml_file_path
    xml_output = None

    if xml_file and os.path.exists(xml_file):
        with open(xml_file, 'r') as file:
            xml_output = file.read() if xml_file else None

    repo_xml_output = run_repo_check()

    window = UpdateManager(xml_output, repo_xml_output)
    window.hide()

    sys.exit(app.exec())