#!/bin/bash
# System upgrade launcher with optional self-update of update-manager.

set -euo pipefail

GITHUB_API="https://api.github.com/repos/jpmsb/update-manager/releases/latest"
PACKAGE_NAME="update-manager"
ZYPPER_UPGRADE=(/usr/bin/zypper dist-upgrade --auto-agree-with-licenses --replacefiles --force-resolution)

detect_ui_lang() {
    local lang="${LC_ALL:-${LC_MESSAGES:-${LANG:-en_US.UTF-8}}}"
    lang="${lang%%.*}"
    lang="${lang%%_*}"
    lang=$(echo "$lang" | tr '[:upper:]' '[:lower:]')
    case "$lang" in
        pt) echo "pt" ;;
        *) echo "en" ;;
    esac
}

UI_LANG="$(detect_ui_lang)"

# Color / dynamic UI when stdout is a terminal.
if [ -t 1 ]; then
    USE_COLOR=1
else
    USE_COLOR=0
fi

msg() {
    local key="$1"
    case "$UI_LANG:$key" in
        pt:terminal_title) echo "Instalar atualizações" ;;
        pt:phase_self) echo "update-manager" ;;
        pt:checking_self) echo "Consultando GitHub…" ;;
        pt:self_updating) echo "Nova versão disponível" ;;
        pt:self_installing) echo "Instalando" ;;
        pt:self_ok) echo "Atualizado" ;;
        pt:self_fail) echo "Falha ao atualizar; seguindo com o sistema" ;;
        pt:phase_repos) echo "Repositórios" ;;
        pt:refreshing_repos) echo "Atualizando metadados…" ;;
        pt:phase_upgrade) echo "Sistema" ;;
        pt:proceeding) echo "zypper dist-upgrade — revise e confirme" ;;
        pt:something_wrong) echo "Algo deu errado. Você pode tentar novamente." ;;
        pt:press_enter) echo "Pressione ENTER para sair…" ;;
        pt:must_be_root) echo "Este modo requer root." ;;

        *:terminal_title) echo "Install updates" ;;
        *:phase_self) echo "update-manager" ;;
        *:checking_self) echo "Checking GitHub…" ;;
        *:self_updating) echo "New version available" ;;
        *:self_installing) echo "Installing" ;;
        *:self_ok) echo "Updated" ;;
        *:self_fail) echo "Update failed; continuing with the system" ;;
        *:phase_repos) echo "Repositories" ;;
        *:refreshing_repos) echo "Refreshing metadata…" ;;
        *:phase_upgrade) echo "System" ;;
        *:proceeding) echo "zypper dist-upgrade — review and confirm" ;;
        *:something_wrong) echo "Something went wrong. You can try again." ;;
        *:press_enter) echo "Press ENTER to exit…" ;;
        *:must_be_root) echo "This mode requires root." ;;
        *) echo "$key" ;;
    esac
}

_c() {
    local code="$1" text="$2"
    if [ "$USE_COLOR" -eq 1 ]; then
        printf '\033[%sm%s\033[0m' "$code" "$text"
    else
        printf '%s' "$text"
    fi
}

# Modern phase header: accent bar + bold title (no multi-line boxes).
phase() {
    echo
    if [ "$USE_COLOR" -eq 1 ]; then
        printf '%s %s\n' "$(_c '1;36' '▍')" "$(_c '1' "$1")"
        printf '\033[2m%s\033[0m\n' "────────────────────────────────"
    else
        printf '== %s ==\n' "$1"
    fi
}

ok()   { printf '  %s %s\n' "$(_c '1;32' '✓')" "$1"; }
warn() { printf '  %s %s\n' "$(_c '1;33' '!')" "$1"; }
err()  { printf '  %s %s\n' "$(_c '1;31' '✗')" "$1"; }
info() { printf '  %s %s\n' "$(_c '2' '·')" "$1"; }

SPIN_PID=""

start_spin() {
    local message="$1"
    [ "$USE_COLOR" -eq 1 ] || { info "$message"; return 0; }
    (
        local i=0
        local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
        local n=${#frames[@]}
        while true; do
            printf '\r  \033[1;36m%s\033[0m %s' "${frames[i++%n]}" "$message"
            sleep 0.08
        done
    ) &
    SPIN_PID=$!
}

stop_spin() {
    if [ -n "${SPIN_PID:-}" ]; then
        kill "$SPIN_PID" 2>/dev/null || true
        wait "$SPIN_PID" 2>/dev/null || true
        SPIN_PID=""
        printf '\r\033[K'
    fi
}

version_gt() {
    local remote="$1" local_ver="$2"
    python3 -c '
import sys
def parts(v):
    out = []
    for p in v.lstrip("vV").split("."):
        try:
            out.append(int(p))
        except ValueError:
            out.append(0)
    return out
remote, current = sys.argv[1], sys.argv[2]
sys.exit(0 if parts(remote) > parts(current) else 1)
' "$remote" "$local_ver"
}

stop_packagekit() {
    local timeout_sec="${1:-3}"
    local end=$((SECONDS + timeout_sec))

    while [ "$SECONDS" -lt "$end" ]; do
        pkill -f "packagekitd" -9 2>/dev/null || true
        sleep 0.1
    done
}

clear_zypp_lock() {
    echo "" > /run/zypp.pid
}

self_update_update_manager() {
    # Quiet unless there is a real update to install.
    start_spin "$(msg checking_self)"

    local json tag rpm_url current tmp_rpm
    if ! json=$(curl -fsSL \
        -A "update-manager-self-update" \
        -H "Accept: application/vnd.github+json" \
        "$GITHUB_API" 2>/dev/null); then
        stop_spin
        return 0
    fi

    tag=""
    rpm_url=""
    {
        read -r tag
        read -r rpm_url
    } < <(
        printf '%s' "$json" | python3 -c '
import json, sys
data = json.load(sys.stdin)
tag = data.get("tag_name", "") or ""
url = ""
for a in data.get("assets", []):
    name = a.get("name", "")
    if name.endswith(".rpm") and "update-manager" in name:
        url = a.get("browser_download_url", "") or ""
        break
print(tag)
print(url)
' 2>/dev/null || true
    ) || true

    if [ -z "${tag:-}" ] || [ -z "${rpm_url:-}" ]; then
        stop_spin
        return 0
    fi

    current=$(rpm -q --qf '%{VERSION}' "$PACKAGE_NAME" 2>/dev/null || true)
    if [ -z "${current:-}" ]; then
        current="0"
    fi

    if ! version_gt "$tag" "$current"; then
        stop_spin
        return 0
    fi

    stop_spin
    phase "$(msg phase_self)"
    warn "$(msg self_updating): $current → $tag"
    info "$(msg self_installing)…"

    tmp_rpm=$(mktemp /tmp/update-manager-XXXXXX.rpm)
    if curl -fsSL -A "update-manager-self-update" -o "$tmp_rpm" "$rpm_url" \
        && rpm -U --quiet "$tmp_rpm"; then
        ok "$(msg self_ok) ($tag)"
    else
        err "$(msg self_fail)"
    fi
    rm -f "$tmp_rpm"
}

refresh_repos() {
    phase "$(msg phase_repos)"
    start_spin "$(msg refreshing_repos)"
    clear_zypp_lock
    set +e
    pkcon get-updates >/dev/null 2>&1
    set -e
    sleep 0.3
    stop_spin
}

run_upgrade() {
    local rc
    phase "$(msg phase_upgrade)"
    info "$(msg proceeding)"
    echo

    clear_zypp_lock
    set +e
    "${ZYPPER_UPGRADE[@]}"
    rc=$?
    set -e

    if [ "$rc" -ne 0 ]; then
        echo
        err "$(msg something_wrong)"
    fi
}

run_as_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "$(msg must_be_root)" >&2
        exit 1
    fi

    export ZYPP_CURL2=1
    export ZYPP_PCK_PRELOAD=1
    export ZYPP_MEDIANETWORK=1

    trap 'stop_spin' EXIT

    self_update_update_manager

    refresh_repos
    stop_packagekit 3 &
    disown || true
    run_upgrade

    rm -rf /var/tmp/rpm-tmp.* /var/tmp/zypp.*
    rm -f /var/log/update-checker/updates.xml
}

wait_for_enter() {
    echo
    info "$(msg press_enter)"
    if [ -r /dev/tty ] && [ -w /dev/tty ]; then
        read -r _ </dev/tty || true
    else
        read -r _ || true
    fi
}

if [ -n "${DISPLAY:-}" ] && [ -z "${SSH_CONNECTION:-}" ] && [ -z "${SSH_CLIENT:-}" ] && [ -z "${SSH_TTY:-}" ]; then
    RUN_PRIVILEGED="/usr/bin/pkexec"
else
    RUN_PRIVILEGED="/usr/bin/sudo"
fi

case "${1:-}" in
    --root)
        run_as_root
        ;;
    "")
        if [ "$RUN_PRIVILEGED" = "/usr/bin/pkexec" ]; then
            /usr/bin/xfce4-terminal \
                --hide-menubar \
                --hide-toolbar \
                --zoom 1.5 \
                --maximize \
                -e "$0 0" \
                -T "$(msg terminal_title)" \
                >/dev/null 2>&1 & disown
        else
            "$RUN_PRIVILEGED" "$0" --root
            wait_for_enter
            timeout 3 dbus-send --session --type=method_call \
                --dest=org.updateViewer /org/updateViewer \
                org.updateViewer.Manager.poll_updates >/dev/null 2>&1 || true
        fi
        ;;
    *)
        "$RUN_PRIVILEGED" "$0" --root
        wait_for_enter
        timeout 3 dbus-send --session --type=method_call \
            --dest=org.updateViewer /org/updateViewer \
            org.updateViewer.Manager.poll_updates >/dev/null 2>&1 || true
        ;;
esac
