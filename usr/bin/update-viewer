class TimeIntervalWidget(QWidget):
    """Widget para editar intervalos de tempo com spinbox e unidade."""
    def __init__(self, initial_seconds=0, parent=None):
        super().__init__(parent)
        layout = QHBoxLayout()
        layout.setContentsMargins(0, 0, 0, 0)
        
        self.spinbox = QSpinBox()
        self.spinbox.setMinimum(0)
        self.spinbox.setMaximum(999999)
        
        self.unit_combo = QComboBox()
        self.unit_combo.addItems(["segundos", "minutos", "horas", "dias"])
        
        # Converte segundos iniciais para a melhor unidade
        self.set_seconds(initial_seconds)
        
        layout.addWidget(self.spinbox)
        layout.addWidget(self.unit_combo)
        self.setLayout(layout)
    
    def set_seconds(self, seconds):
        """Define o valor em segundos."""
        if seconds < 60:
            self.spinbox.setValue(seconds)
            self.unit_combo.setCurrentIndex(0)  # segundos
        elif seconds < 3600:
            self.spinbox.setValue(seconds // 60)
            self.unit_combo.setCurrentIndex(1)  # minutos
        elif seconds < 86400:
            self.spinbox.setValue(seconds // 3600)
            self.unit_combo.setCurrentIndex(2)  # horas
        else:
            self.spinbox.setValue(seconds // 86400)
            self.unit_combo.setCurrentIndex(3)  # dias
    
    def get_seconds(self):
        """Retorna o valor em segundos."""
        value = self.spinbox.value()
        unit_index = self.unit_combo.currentIndex()
        multipliers = [1, 60, 3600, 86400]  # segundos, minutos, horas, dias
        return value * multipliers[unit_index]

class ConfigDialog(QDialog):
    """Diálogo de configurações."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle(_("Preferências"))
        # Define como não-modal para permitir fechar a janela principal
        self.setModal(False)
        # Armazena referência ao parent para atualizar configurações
        self.parent_manager = parent
        
        # Carrega configurações atuais
        self.current_config = load_config()
        
        # Layout principal - cria diretamente no diálogo para garantir que as margens sejam aplicadas
        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(15, 10, 15, 10)
        main_layout.setSpacing(0)
        
        # Área de rolagem
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAsNeeded)
        self.scroll.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAsNeeded)
        self.scroll_widget = QWidget()
        scroll_layout = QVBoxLayout()
        scroll_layout.setContentsMargins(0, 0, 0, 0)
        scroll_layout.setSpacing(0)
        
        # Grupo: Intervalos
        intervals_group = QGroupBox(_("Intervalos"))
        intervals_group.setFlat(True)
        intervals_layout = QVBoxLayout()
        
        # Refresh interval
        refresh_layout = QHBoxLayout()
        refresh_layout.addWidget(QLabel(_("Intervalo de verificação por atualizações:")))
        refresh_layout.addStretch()  # Empurra o widget para a direita
        self.refresh_widget = TimeIntervalWidget(self.current_config.get('refresh-interval', 60))
        self.refresh_widget.setMinimumWidth(200)  # Define largura mínima para alinhamento
        refresh_layout.addWidget(self.refresh_widget)
        intervals_layout.addLayout(refresh_layout)
        
        # Interval after first successful run
        first_run_layout = QHBoxLayout()
        first_run_layout.addWidget(QLabel(_("Intervalo após primeira execução bem-sucedida:")))
        first_run_layout.addStretch()  # Empurra o widget para a direita
        self.first_run_widget = TimeIntervalWidget(self.current_config.get('interval-after-first-successful-run', 604800))
        self.first_run_widget.setMinimumWidth(200)  # Define largura mínima para alinhamento
        first_run_layout.addWidget(self.first_run_widget)
        intervals_layout.addLayout(first_run_layout)
        
        intervals_group.setLayout(intervals_layout)
        scroll_layout.addWidget(intervals_group)
        
        # Grupo: Idioma
        language_group = QGroupBox(_("Idioma"))
        language_group.setFlat(True)
        language_layout = QVBoxLayout()
        
        language_combo_layout = QHBoxLayout()
        language_combo_layout.addWidget(QLabel(_("Idioma da interface:")))
        language_combo_layout.addStretch()
        self.language_combo = QComboBox()
        # Adiciona opções: Automático (traduzido), English, Português (Brasil), Español, Deutsch, 日本語
        # O texto "Automático" será traduzido dinamicamente
        self.language_combo.addItem(_("Automático"), "auto")
        self.language_combo.addItem("English", "en")
        self.language_combo.addItem("Português (Brasil)", "pt_BR")
        self.language_combo.addItem("Español", "es")
        self.language_combo.addItem("Deutsch", "de")
        self.language_combo.addItem("日本語", "ja")
        
        # Define o idioma atual
        current_lang = self.current_config.get('language', 'auto')
        for i in range(self.language_combo.count()):
            if self.language_combo.itemData(i) == current_lang:
                self.language_combo.setCurrentIndex(i)
                break
        
        self.language_combo.setMinimumWidth(200)
        language_combo_layout.addWidget(self.language_combo)
        language_layout.addLayout(language_combo_layout)
        
        language_group.setLayout(language_layout)
        scroll_layout.addWidget(language_group)
        
        # Grupo: Comportamento
        behavior_group = QGroupBox(_("Comportamento do lembrete"))
        behavior_group.setFlat(True)
        behavior_layout = QVBoxLayout()
        
        # Interval remind later
        remind_layout = QHBoxLayout()
        remind_layout.addWidget(QLabel(_("Intervalo para lembrar mais tarde:")))
        remind_layout.addStretch()  # Empurra o widget para a direita
        self.remind_widget = TimeIntervalWidget(self.current_config.get('interval-remind-later', 3600))
        self.remind_widget.setMinimumWidth(200)  # Define largura mínima para alinhamento
        remind_layout.addWidget(self.remind_widget)
        behavior_layout.addLayout(remind_layout)

        # After remind later show
        after_remind_layout = QHBoxLayout()
        after_remind_layout.addWidget(QLabel(_("Quando o tempo de espera terminar, mostrar:")))
        after_remind_layout.addStretch()  # Empurra o widget para a direita
        self.after_remind_combo = QComboBox()
        # Adiciona itens com texto em português, mas armazena valores em inglês
        self.after_remind_combo.addItem(_("janela"), "window")
        self.after_remind_combo.addItem(_("notificação"), "notification")
        current_value = self.current_config.get('after-remind-later-show', 'window').lower().strip()
        # Encontra o índice baseado no valor em inglês
