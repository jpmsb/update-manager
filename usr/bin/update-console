# xfce4-terminal-like dark palette (normal + bright)
ANSI_COLORS = [
    "#000000",  # 0 black
    "#cd0000",  # 1 red
    "#00cd00",  # 2 green
    "#cdcd00",  # 3 yellow
    "#0000ee",  # 4 blue
    "#cd00cd",  # 5 magenta
    "#00cdcd",  # 6 cyan
    "#e5e5e5",  # 7 white
    "#7f7f7f",  # 8 bright black
    "#ff0000",  # 9 bright red
    "#00ff00",  # 10 bright green
    "#ffff00",  # 11 bright yellow
    "#5c5cff",  # 12 bright blue
    "#ff00ff",  # 13 bright magenta
    "#00ffff",  # 14 bright cyan
    "#ffffff",  # 15 bright white
]

DEFAULT_FG = "#dcdcdc"
DEFAULT_BG = "#000000"
FONT_POINT_SIZE = 16


def detect_ui_lang() -> str:
    """Return en/pt/es/de/ja, matching update-viewer supported languages."""
    raw = (
        os.environ.get("LC_ALL")
        or os.environ.get("LC_MESSAGES")
        or os.environ.get("LANG")
        or "en_US.UTF-8"
    )
    full = raw.split(".")[0].lower()
    lang = full.split("_")[0]
    mapping = {
        "pt": "pt",
        "pt_br": "pt",
        "pt_pt": "pt",
        "es": "es",
        "es_es": "es",
        "es_mx": "es",
        "de": "de",
        "de_de": "de",
        "de_at": "de",
        "de_ch": "de",
        "ja": "ja",
        "ja_jp": "ja",
        "en": "en",
        "en_us": "en",
        "en_gb": "en",
    }
    if full in mapping:
        return mapping[full]
    if lang in mapping:
        return mapping[lang]
    return "en"


def tr(key: str, **kwargs) -> str:
    lang = detect_ui_lang()
    table = MESSAGES.get(lang) or MESSAGES["en"]
    text = table.get(key) or MESSAGES["en"][key]
    return text.format(**kwargs) if kwargs else text


def window_title() -> str:
    return tr("window_title")


_MONO_FAMILY: str | None = None


def pick_mono_font(point_size: int = FONT_POINT_SIZE) -> QFont:
    global _MONO_FAMILY
    if _MONO_FAMILY is None:
        preferred = ["Hack", "Source Code Pro", "DejaVu Sans Mono", "Liberation Mono", "Monospace"]
        available = set(QFontDatabase.families())
        _MONO_FAMILY = next((name for name in preferred if name in available), "Monospace")
    font = QFont(_MONO_FAMILY)
    font.setStyleHint(QFont.StyleHint.Monospace)
    font.setFixedPitch(True)
    font.setPointSize(point_size)
    return font


class AnsiState:
    def __init__(self) -> None:
        self.font_size = FONT_POINT_SIZE
        self._fmt_cache: dict[tuple, QTextCharFormat] = {}
        self.reset()

    def reset(self) -> None:
        self.fg = DEFAULT_FG
        self.bold = False
        self.dim = False
        self.fg_idx: int | None = None

    def apply_sgr(self, params: list[int]) -> None:
        if not params:
            params = [0]
        i = 0
        while i < len(params):
            code = params[i]
            if code == 0:
                self.reset()
            elif code == 1:
                self.bold = True
                self.dim = False
            elif code == 2:
                self.dim = True
            elif code == 22:
                self.bold = False
                self.dim = False
            elif code == 39:
                self.fg = DEFAULT_FG
                self.fg_idx = None
            elif 30 <= code <= 37:
                self.fg_idx = code - 30
                self.fg = ANSI_COLORS[self.fg_idx]
            elif 90 <= code <= 97:
                self.fg_idx = (code - 90) + 8
                self.fg = ANSI_COLORS[self.fg_idx]
            elif code == 38 and i + 2 < len(params) and params[i + 1] == 5:
                idx = params[i + 2] % 256
                if idx < 16:
                    self.fg_idx = idx
                    self.fg = ANSI_COLORS[idx]
                i += 2
            i += 1
        if self.bold and self.fg_idx is not None and self.fg_idx < 8:
            self.fg = ANSI_COLORS[self.fg_idx + 8]

    def char_format(self) -> QTextCharFormat:
        # Rebuilt only when the SGR state or font size changes (not per character).
        key = (self.fg, self.bold, self.dim, self.font_size)
        cached = self._fmt_cache.get(key)
        if cached is not None:
            return cached
        fmt = QTextCharFormat()
        color = QColor(self.fg)
        if self.dim and not self.bold:
            color = color.darker(150)
        fmt.setForeground(color)
        font = pick_mono_font(self.font_size)
        font.setBold(self.bold)
        fmt.setFont(font)
        self._fmt_cache[key] = fmt
        return fmt


class PtySession(QObject):
    output = pyqtSignal(bytes)
    exited = pyqtSignal(int)

    def __init__(self, argv: list[str], parent: QObject | None = None) -> None:
        super().__init__(parent)
        self._proc: subprocess.Popen[bytes] | None = None
        self._master_fd = -1
        self._notifier: QSocketNotifier | None = None

        master_fd, slave_fd = pty.openpty()
        self._master_fd = master_fd

        flags = fcntl.fcntl(master_fd, fcntl.F_GETFL)
        fcntl.fcntl(master_fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)

        env = os.environ.copy()
        env["TERM"] = "xterm-256color"
        env["COLORTERM"] = "truecolor"

        # subprocess + PTY avoids a manual fork/exec after Qt threads start.
        self._proc = subprocess.Popen(
            argv,
            stdin=slave_fd,
            stdout=slave_fd,
            stderr=slave_fd,
            start_new_session=True,
            env=env,
            close_fds=True,
        )
        os.close(slave_fd)

        self._notifier = QSocketNotifier(master_fd, QSocketNotifier.Type.Read, self)
        self._notifier.activated.connect(self._on_readable)

        self._child_timer = QTimer(self)
        self._child_timer.setInterval(200)
        self._child_timer.timeout.connect(self._poll_child)
        self._child_timer.start()

    def set_winsize(self, rows: int, cols: int) -> None:
        if self._master_fd < 0:
            return
        try:
            winsize = struct.pack("HHHH", max(rows, 1), max(cols, 1), 0, 0)
            fcntl.ioctl(self._master_fd, termios.TIOCSWINSZ, winsize)
            if self._proc is not None and self._proc.pid:
                os.kill(self._proc.pid, signal.SIGWINCH)
        except OSError:
            pass

    def is_canonical(self) -> bool:
        if self._master_fd < 0:
            return True
        try:
            return bool(termios.tcgetattr(self._master_fd)[3] & termios.ICANON)
        except OSError:
            return True

    def write(self, data: bytes) -> None:
        if self._master_fd < 0 or not data:
            return
        try:
            os.write(self._master_fd, data)
        except OSError:
            pass

    def _on_readable(self, *_args) -> None:
        if self._master_fd < 0:
            return
        try:
            for _ in range(8):
                chunk = os.read(self._master_fd, 8192)
                if not chunk:
                    self._cleanup_fd()
                    return
                self.output.emit(chunk)
                readable, _, _ = select.select([self._master_fd], [], [], 0)
                if not readable:
                    break
        except BlockingIOError:
            return
        except OSError:
            self._cleanup_fd()

    def _poll_child(self) -> None:
        if self._proc is None:
            return
        code = self._proc.poll()
        if code is None:
            return
        self._child_timer.stop()
        self._cleanup_fd()
        self.exited.emit(int(code))
        self._proc = None

    def _cleanup_fd(self) -> None:
        if self._notifier is not None:
            self._notifier.setEnabled(False)
            self._notifier.deleteLater()
            self._notifier = None
        if self._master_fd >= 0:
            try:
                os.close(self._master_fd)
            except OSError:
                pass
            self._master_fd = -1

    def terminate(self) -> None:
        if self._proc is not None and self._proc.poll() is None:
            try:
                os.killpg(self._proc.pid, signal.SIGTERM)
            except OSError:
                try:
                    self._proc.terminate()
                except OSError:
                    pass


class ConsoleView(QPlainTextEdit):
    input_bytes = pyqtSignal(bytes)
    prompt_option_clicked = pyqtSignal(str)
    prompt_option_submitted = pyqtSignal(str)
    prompt_confirm_clicked = pyqtSignal()
    prompt_clear_clicked = pyqtSignal()
    font_size_changed = pyqtSignal(int)

    def __init__(self, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        # Keep editable=True so Qt natively draws and blinks the text cursor;
        # keyPressEvent and insertFromMimeData route all input to the PTY.
        self.setReadOnly(False)
        self.setUndoRedoEnabled(False)
        self.setMaximumBlockCount(20000)
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
        self.setMouseTracking(True)
        self.viewport().setMouseTracking(True)
        self._ansi = AnsiState()
        self._csi_buf = ""
        self._in_esc = False
        self._in_csi = False
        self._in_osc = False
        self._osc_buf = ""
        self._utf8_pending = b""
        self._line_col = 0
        self._active_prompt_block: int | None = None
        self._active_options: list[str] = []
        self._active_default_opt: str | None = None
        self._selected_opt_idx: int | None = None
        self._prompt_buttons: list[QPushButton] = []
        self._help_buttons: list[tuple[int, int, str, QPushButton]] = []
        self._highlighted_help_span: tuple[int, int, int] | None = None
        self._is_canonical = lambda: True
        self._font_size = FONT_POINT_SIZE
        self._follow_tail = True
        self._updating_scroll = False
        self.verticalScrollBar().valueChanged.connect(self._on_scroll_changed)
        self.verticalScrollBar().rangeChanged.connect(self._on_range_changed)

        self._button_qss = """
            QPushButton {
                background-color: #24292f;
