# ================= Internacionalização (i18n) =================

# Domínio de tradução
TRANSLATION_DOMAIN = "update-viewer"

# Variável global para função de tradução
_ = None

def detect_system_language():
    """
    Detecta o idioma do sistema e retorna o código de idioma suportado.
    Retorna 'en' como fallback se o idioma não for suportado.
    """
    # Idiomas suportados
    supported_languages = {
        'en': 'en',
        'pt': 'pt_BR',
        'pt_BR': 'pt_BR',
        'pt_PT': 'pt_BR',  # Português de Portugal também usa pt_BR
        'es': 'es',
        'es_ES': 'es',
        'es_MX': 'es',
        'de': 'de',
        'de_DE': 'de',
        'de_AT': 'de',
        'de_CH': 'de',
        'ja': 'ja',
        'ja_JP': 'ja',
    }
    
    # Tenta obter o idioma do sistema
    try:
        # Primeiro tenta locale.getdefaultlocale()
        system_lang, _ = locale.getdefaultlocale()
        if system_lang:
            # Remove encoding se presente (ex: 'pt_BR.UTF-8' -> 'pt_BR')
            lang_code = system_lang.split('.')[0]
            if lang_code in supported_languages:
                return supported_languages[lang_code]
    except Exception:
        pass
    
    # Tenta variável de ambiente LANG
    try:
        lang_env = os.environ.get('LANG', '')
        if lang_env:
            lang_code = lang_env.split('.')[0].split('_')[0]
            if lang_code in supported_languages:
                return supported_languages[lang_code]
    except Exception:
        pass
    
    # Fallback para inglês
    return 'en'

def init_i18n(lang=None):
    """
    Inicializa o sistema de internacionalização usando gettext.
    
    Args:
        lang: Código de idioma ('auto', 'en', 'pt_BR', 'es', 'de', 'ja') ou None para auto-detectar
    
    Returns:
        Função de tradução _()
    """
    global _
    
    # Determina qual idioma usar
    if lang is None or lang == 'auto' or lang == '':
        target_lang = detect_system_language()
    else:
        target_lang = lang
    
    # Caminhos possíveis para os arquivos .mo
    # 1. Produção: /usr/share/locale
    # 2. Desenvolvimento: locale/ (relativo ao script)
    script_dir = os.path.dirname(os.path.abspath(__file__))
    possible_paths = [
        '/usr/share/locale',
        os.path.join(script_dir, 'locale'),
        os.path.join(os.path.dirname(script_dir), 'locale'),
    ]
    
    # Tenta encontrar o arquivo .mo em cada caminho
    translation = None
    for locale_path in possible_paths:
        try:
            translation = gettext.translation(
                TRANSLATION_DOMAIN,
                localedir=locale_path,
                languages=[target_lang],
                fallback=True
            )
            # Se encontrou uma tradução válida (não é fallback), usa ela
            if translation and hasattr(translation, '_catalog') and translation._catalog:
                break
        except Exception:
            continue
    
    # Se não encontrou tradução, usa gettext sem tradução (retorna string original)
    if translation is None:
        translation = gettext.NullTranslations()
    
    # Instala a tradução no namespace global
    translation.install()
    _ = translation.gettext
    
    return _

# Inicializa i18n com auto-detecção
init_i18n()

# ================= Funções de configuração =================

def eval_math_expression(expr):
    """
    Avalia uma expressão matemática simples de forma segura.
    Aceita apenas números, espaços e operadores básicos (+, -, *, /).
    """
    try:
        # Remove espaços
        expr = expr.strip()
        # Valida que contém apenas números, espaços e operadores permitidos
        if not re.match(r'^[\d\s\+\-\*\/\(\)\.]+$', expr):
            raise ValueError("Expressão contém caracteres inválidos")
        # Usa eval com namespace restrito (sem __builtins__) para segurança
        # A validação com regex garante que só contém operações matemáticas básicas
        allowed_names = {
            "__builtins__": {},
        }
        # Remove espaços e avalia
        expr_clean = ''.join(expr.split())
        result = eval(expr_clean, allowed_names)
        return int(result) if isinstance(result, float) and result.is_integer() else result
    except Exception as e:
        raise ValueError(f"Erro ao avaliar expressão '{expr}': {e}")

def get_config_path():
    """Retorna o caminho do arquivo de configuração."""
    config_dir = os.path.join(os.path.expanduser("~"), ".config", "update-viewer")
    config_file = os.path.join(config_dir, "update-viewer.conf")
    return config_file

def create_default_config(config_path):
    """Cria o arquivo de configuração padrão se não existir."""
    config_dir = os.path.dirname(config_path)
    os.makedirs(config_dir, exist_ok=True)
    
    default_config = """[General]
# Intervalo para checar se há novas atualizações (em segundos)
refresh-interval = 60  # 1 minuto

# Intervalo para forçar a exibição da janela caso o usuário não interaja (em segundos)
interval-after-first-successful-run = 60 * 60 * 24 * 7  # 7 dias

# Intervalo para lembrar mais tarde (em segundos)
interval-remind-later = 60 * 60  # 1 hora

# O que mostrar após o intervalo de "lembrar mais tarde": "window" ou "notification"
after-remind-later-show = window

# Define se a janela principal é aberta ao clicar na notificação
open-window-on-notification-click = true

# Local dos arquivos de log e XML
update-checker-files-directory = /var/log/update-checker

# Caminho do arquivo XML de atualizações
# xml-file-path = /var/log/update-checker/updates.xml

# Caminho do arquivo de log de execução
# run-log-file-path = /var/log/update-checker/run.log

# Comando para atualizar o sistema (caminho absoluto, pode incluir argumentos)
update-command = /usr/bin/update-system

# Idioma da interface (auto, en, pt_BR, es, de, ja)
# auto = detecta automaticamente o idioma do sistema
language = auto
"""
    
    with open(config_path, 'w', encoding='utf-8') as f:
        f.write(default_config)
    
    return True

def load_config():
    """Carrega as configurações do arquivo de configuração."""
    config_path = get_config_path()
    
    # Cria arquivo padrão se não existir
    if not os.path.exists(config_path):
        create_default_config(config_path)
        print(f"[update-viewer] Arquivo de configuração criado em: {config_path}")
    
    config = {}
    current_section = None
    
    try:
        with open(config_path, 'r', encoding='utf-8') as f:
            for line in f:
                # Remove espaços no início e fim
                line = line.strip()
                
                # Ignora linhas vazias e comentários
                if not line or line.startswith('#'):
                    continue
                
                # Detecta seções [Section]
                if line.startswith('[') and line.endswith(']'):
                    current_section = line[1:-1]
                    continue
                
                # Processa chave = valor
                if '=' in line:
                    # Separa chave e valor
                    parts = line.split('=', 1)
                    key = parts[0].strip()
                    value = parts[1].strip()
                    
                    # Remove comentários do valor (tudo após #)
                    if '#' in value:
                        value = value.split('#')[0].strip()
                    
                    # Tenta avaliar como expressão matemática se for numérico
                    if key in ['refresh-interval', 'interval-after-first-successful-run',
                              'interval-after-zypper-dist-upgrade', 'interval-after-zypper-dist-upgrade-check',
                              'interval-remind-later']:
                        try:
                            config[key] = eval_math_expression(value)
                        except ValueError as e:
                            print(f"[update-viewer] Aviso: Erro ao processar '{key}': {e}. Usando valor padrão.")
                            continue
                    # Processa valores booleanos
                    elif key in ['open-window-on-notification-click']:
                        config[key] = value.lower() in ['true', '1', 'yes', 'on']
                    else:
                        config[key] = value
    
    except Exception as e:
        print(f"[update-viewer] Erro ao ler arquivo de configuração: {e}. Usando valores padrão.")
    
    # Define valores padrão se não foram encontrados
    defaults = {
        'refresh-interval': 60,
        'interval-after-first-successful-run': 60 * 60 * 24 * 7,
        'interval-after-zypper-dist-upgrade': 5,
        'interval-after-zypper-dist-upgrade-check': 10,
        'interval-remind-later': 60 * 60,
        'after-remind-later-show': 'window',
        'open-window-on-notification-click': True,
        'update-checker-files-directory': '/var/log/update-checker',
        'update-command': '/usr/bin/update-system',
        'language': 'auto'
    }
    
    for key, default_value in defaults.items():
        if key not in config:
            config[key] = default_value
    
    # Define xml-file-path e run-log-file-path baseado em update-checker-files-directory se não especificados
    if 'xml-file-path' not in config:
        config['xml-file-path'] = os.path.join(config['update-checker-files-directory'], 'updates.xml')
    if 'run-log-file-path' not in config:
        config['run-log-file-path'] = os.path.join(config['update-checker-files-directory'], 'run.log')
    
    return config

def save_config(config_dict):
    """Salva as configurações no arquivo de configuração."""
    config_path = get_config_path()
    config_dir = os.path.dirname(config_path)
    os.makedirs(config_dir, exist_ok=True)
    
    # Lê o arquivo existente para preservar comentários e estrutura
    lines = []
    if os.path.exists(config_path):
        with open(config_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()
    
    # Cria um novo conteúdo preservando comentários quando possível
    output_lines = ["[General]\n"]
    
    # Mapeia chaves para seus comentários
    comments = {
        'refresh-interval': '# Intervalo para checar se há novas atualizações (em segundos)',
        'interval-after-first-successful-run': '# Intervalo para forçar a exibição da janela caso o usuário não interaja (em segundos)',
        'interval-after-zypper-dist-upgrade': '# Intervalo após zypper dist-upgrade (em segundos)',
        'interval-after-zypper-dist-upgrade-check': '# Intervalo para verificar novamente se zypper dist-upgrade terminou (em segundos)',
        'interval-remind-later': '# Intervalo para lembrar mais tarde (em segundos)',
        'after-remind-later-show': '# O que mostrar após o intervalo de "lembrar mais tarde": "window" ou "notification"',
        'open-window-on-notification-click': '# Define se a janela principal é aberta ao clicar na notificação (true/false)',
        'update-checker-files-directory': '# Local dos arquivos de log e XML',
        'xml-file-path': '# Caminho do arquivo XML de atualizações',
        'run-log-file-path': '# Caminho do arquivo de log de execução',
        'update-command': '# Comando para atualizar o sistema (caminho absoluto, pode incluir argumentos)',
        'language': '# Idioma da interface (auto, en, pt_BR, es, de, ja)'
    }
    
    # Escreve as configurações
    for key, value in config_dict.items():
        if key in comments:
            output_lines.append(f"{comments[key]}\n")
        # Converte booleanos para strings
        if isinstance(value, bool):
            value_str = "true" if value else "false"
        else:
            value_str = str(value)
        output_lines.append(f"{key} = {value_str}\n")
        output_lines.append("\n")
    
    # Salva o arquivo
    with open(config_path, 'w', encoding='utf-8') as f:
        f.writelines(output_lines)
    
    return True

# Carrega configurações ao importar o módulo
_CONFIG = load_config()

# Recarrega i18n com a configuração de idioma se especificada
# Isso garante que o idioma correto seja usado desde o início
if 'language' in _CONFIG:
    _ = init_i18n(_CONFIG['language'])
else:
    # Se não houver configuração, usa auto-detecção
    _ = init_i18n('auto')

