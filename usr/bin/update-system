#!/bin/bash
# System upgrade launcher with optional self-update of update-manager.

set -euo pipefail

GITHUB_API="https://api.github.com/repos/jpmsb/update-manager/releases/latest"
PACKAGE_NAME="update-manager"
# Exit status of the last zypper upgrade, reported to the caller (update-console shows it).
UPGRADE_RC=0
# Set by update-console (--root --console): it reports the result itself.
CONSOLE_REPORTS_RESULT=0
ZYPPER_UPGRADE=(/usr/bin/zypper dist-upgrade --auto-agree-with-licenses --replacefiles --force-resolution)

detect_ui_lang() {
    # Align with update-viewer: en, pt, es, de, ja
    local raw="${LC_ALL:-${LC_MESSAGES:-${LANG:-en_US.UTF-8}}}"
    raw="${raw%%.*}"
    local full
    full=$(echo "$raw" | tr '[:upper:]' '[:lower:]')
    local lang="${full%%_*}"
    case "$full" in
        pt|pt_br|pt_pt) echo "pt" ;;
        es|es_es|es_mx) echo "es" ;;
        de|de_de|de_at|de_ch) echo "de" ;;
        ja|ja_jp) echo "ja" ;;
        en|en_us|en_gb) echo "en" ;;
        *)
            case "$lang" in
                pt) echo "pt" ;;
                es) echo "es" ;;
                de) echo "de" ;;
                ja) echo "ja" ;;
                *) echo "en" ;;
            esac
            ;;
    esac
}

UI_LANG="$(detect_ui_lang)"

# Color / dynamic UI when stdout is a terminal.
if [ -t 1 ]; then
    USE_COLOR=1
else
    USE_COLOR=0
fi

msg() {
    local key="$1"
    case "$UI_LANG:$key" in
        pt:terminal_title) echo "Instalar atualizações" ;;
        pt:phase_self) echo "update-manager" ;;
        pt:checking_self) echo "Consultando GitHub…" ;;
        pt:self_updating) echo "Nova versão disponível" ;;
        pt:self_installing) echo "Instalando" ;;
        pt:self_ok) echo "Atualizado" ;;
        pt:self_fail) echo "Falha ao atualizar; seguindo com o sistema" ;;
        pt:phase_repos) echo "Repositórios" ;;
        pt:refreshing_repos) echo "Atualizando metadados…" ;;
        pt:repos_done) echo "Metadados atualizados" ;;
        pt:repo_fail) echo "Falha ao atualizar metadados" ;;
        pt:expired_key_removed) echo "Chave GPG expirada removida para renovação" ;;
        pt:phase_upgrade) echo "Sistema" ;;
        pt:proceeding) echo "zypper dist-upgrade — revise e confirme" ;;
        pt:something_wrong) echo "Algo deu errado. Você pode tentar novamente." ;;
        pt:press_enter) echo "Pressione ENTER para sair…" ;;
        pt:must_be_root) echo "Este modo requer root." ;;
        pt:no_console) echo "Não foi possível abrir o console de atualização (update-console). Verifique se o pacote update-manager está instalado e se a sessão gráfica está ativa." ;;
        pt:usage) echo "Uso: update-system [--help]
       atualizar-sistema [--help]

Inicia a atualização do sistema (zypper dist-upgrade) com elevação de privilégios.
Em sessão gráfica, abre o console próprio (update-console)." ;;

        es:terminal_title) echo "Instalar actualizaciones" ;;
        es:phase_self) echo "update-manager" ;;
        es:checking_self) echo "Consultando GitHub…" ;;
        es:self_updating) echo "Nueva versión disponible" ;;
        es:self_installing) echo "Instalando" ;;
        es:self_ok) echo "Actualizado" ;;
        es:self_fail) echo "Error al actualizar; continuando con el sistema" ;;
        es:phase_repos) echo "Repositorios" ;;
        es:refreshing_repos) echo "Actualizando metadatos…" ;;
        es:repos_done) echo "Metadatos actualizados" ;;
        es:repo_fail) echo "Error al actualizar metadatos" ;;
        es:expired_key_removed) echo "Clave GPG caducada eliminada para renovación" ;;
        es:phase_upgrade) echo "Sistema" ;;
        es:proceeding) echo "zypper dist-upgrade — revise y confirme" ;;
        es:something_wrong) echo "Algo salió mal. Puede intentarlo de nuevo." ;;
        es:press_enter) echo "Pulse ENTER para salir…" ;;
        es:must_be_root) echo "Este modo requiere root." ;;
        es:no_console) echo "No se pudo abrir la consola de actualización (update-console). Compruebe que el paquete update-manager esté instalado y que la sesión gráfica esté activa." ;;
        es:usage) echo "Uso: update-system [--help]
       atualizar-sistema [--help]

Inicia la actualización del sistema (zypper dist-upgrade) con elevación de privilegios.
En sesión gráfica, abre la consola integrada (update-console)." ;;

        de:terminal_title) echo "Aktualisierungen installieren" ;;
        de:phase_self) echo "update-manager" ;;
        de:checking_self) echo "GitHub wird abgefragt…" ;;
        de:self_updating) echo "Neue Version verfügbar" ;;
        de:self_installing) echo "Installation" ;;
        de:self_ok) echo "Aktualisiert" ;;
        de:self_fail) echo "Aktualisierung fehlgeschlagen; Systemaktualisierung wird fortgesetzt" ;;
        de:phase_repos) echo "Repositories" ;;
        de:refreshing_repos) echo "Metadaten werden aktualisiert…" ;;
        de:repos_done) echo "Metadaten aktualisiert" ;;
        de:repo_fail) echo "Metadaten konnten nicht aktualisiert werden" ;;
        de:expired_key_removed) echo "Abgelaufener GPG-Schlüssel zur Erneuerung entfernt" ;;
        de:phase_upgrade) echo "System" ;;
        de:proceeding) echo "zypper dist-upgrade — prüfen und bestätigen" ;;
        de:something_wrong) echo "Etwas ist schiefgelaufen. Sie können es erneut versuchen." ;;
        de:press_enter) echo "Drücken Sie ENTER zum Beenden…" ;;
        de:must_be_root) echo "Dieser Modus erfordert root." ;;
        de:no_console) echo "Die Update-Konsole (update-console) konnte nicht geöffnet werden. Prüfen Sie, ob das Paket update-manager installiert ist und eine grafische Sitzung aktiv ist." ;;
        de:usage) echo "Aufruf: update-system [--help]
       atualizar-sistema [--help]

Startet eine privilegierte Systemaktualisierung (zypper dist-upgrade).
In einer grafischen Sitzung wird die eigene Konsole (update-console) geöffnet." ;;

        ja:terminal_title) echo "更新をインストール" ;;
        ja:phase_self) echo "update-manager" ;;
        ja:checking_self) echo "GitHub を確認しています…" ;;
        ja:self_updating) echo "新しいバージョンがあります" ;;
        ja:self_installing) echo "インストール中" ;;
        ja:self_ok) echo "更新しました" ;;
        ja:self_fail) echo "更新に失敗しました。システムの更新を続行します" ;;
        ja:phase_repos) echo "リポジトリ" ;;
        ja:refreshing_repos) echo "メタデータを更新しています…" ;;
        ja:repos_done) echo "メタデータを更新しました" ;;
        ja:repo_fail) echo "メタデータの更新に失敗しました" ;;
        ja:expired_key_removed) echo "更新のため期限切れの GPG 鍵を削除しました" ;;
        ja:phase_upgrade) echo "システム" ;;
        ja:proceeding) echo "zypper dist-upgrade — 内容を確認して続行してください" ;;
        ja:something_wrong) echo "問題が発生しました。もう一度お試しください。" ;;
        ja:press_enter) echo "終了するには ENTER を押してください…" ;;
        ja:must_be_root) echo "このモードには root が必要です。" ;;
        ja:no_console) echo "更新コンソール（update-console）を開けませんでした。update-manager パッケージがインストールされているか、グラフィカルセッションが有効かを確認してください。" ;;
        ja:usage) echo "使い方: update-system [--help]
       atualizar-sistema [--help]

特権付きでシステム更新（zypper dist-upgrade）を開始します。
グラフィカルセッションでは内蔵コンソール（update-console）を開きます。" ;;

        *:terminal_title) echo "Install updates" ;;
        *:phase_self) echo "update-manager" ;;
        *:checking_self) echo "Checking GitHub…" ;;
        *:self_updating) echo "New version available" ;;
        *:self_installing) echo "Installing" ;;
        *:self_ok) echo "Updated" ;;
        *:self_fail) echo "Update failed; continuing with the system" ;;
        *:phase_repos) echo "Repositories" ;;
        *:refreshing_repos) echo "Refreshing metadata…" ;;
        *:repos_done) echo "Metadata refreshed" ;;
        *:repo_fail) echo "Failed to refresh metadata" ;;
        *:expired_key_removed) echo "Expired GPG key removed for renewal" ;;
        *:phase_upgrade) echo "System" ;;
        *:proceeding) echo "zypper dist-upgrade — review and confirm" ;;
        *:something_wrong) echo "Something went wrong. You can try again." ;;
        *:press_enter) echo "Press ENTER to exit…" ;;
        *:must_be_root) echo "This mode requires root." ;;
        *:no_console) echo "Could not open the update console (update-console). Ensure the update-manager package is installed and a graphical session is active." ;;
        *:usage) echo "Usage: update-system [--help]
       atualizar-sistema [--help]

Starts a privileged system upgrade (zypper dist-upgrade).
On a graphical session, opens the built-in console (update-console)." ;;
        *) echo "$key" ;;
    esac
}

_c() {
    local code="$1" text="$2"
    if [ "$USE_COLOR" -eq 1 ]; then
        printf '\033[%sm%s\033[0m' "$code" "$text"
    else
        printf '%s' "$text"
    fi
}

# Modern phase header: accent bar + bold title (no multi-line boxes).
phase() {
    echo
    if [ "$USE_COLOR" -eq 1 ]; then
        printf '%s %s\n' "$(_c '1;36' '▍')" "$(_c '1' "$1")"
        printf '\033[2m%s\033[0m\n' "────────────────────────────────"
    else
        printf '== %s ==\n' "$1"
    fi
}

ok()   { printf '  %s %s\n' "$(_c '1;32' '✓')" "$1"; }
warn() { printf '  %s %s\n' "$(_c '1;33' '!')" "$1"; }
upd()  { printf '  %s %s\n' "$(_c '1;36' '↑')" "$1"; }
err()  { printf '  %s %s\n' "$(_c '1;31' '✗')" "$1"; }
info() { printf '  %s %s\n' "$(_c '2' '·')" "$1"; }

SPIN_PID=""

start_spin() {
    local message="$1"
    [ "$USE_COLOR" -eq 1 ] || { info "$message"; return 0; }
    (
        local i=0
        local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
        local n=${#frames[@]}
        while true; do
            printf '\r  \033[1;36m%s\033[0m %s' "${frames[i++%n]}" "$message"
            sleep 0.08
        done
    ) &
    SPIN_PID=$!
}

stop_spin() {
    if [ -n "${SPIN_PID:-}" ]; then
        kill "$SPIN_PID" 2>/dev/null || true
        wait "$SPIN_PID" 2>/dev/null || true
        SPIN_PID=""
        printf '\r\033[K'
    fi
}

# Determinate progress: [████░░░░]  8/22  label
draw_progress() {
    local current="$1" total="$2" label="$3"
    local width=24
    local filled=0
    local max_label=40
    local i bar=""

    if [ "$total" -gt 0 ]; then
        filled=$((current * width / total))
        [ "$filled" -gt "$width" ] && filled=$width
    fi

    if [ "${#label}" -gt "$max_label" ]; then
        label="${label:0:$((max_label - 1))}…"
    fi

    if [ "$USE_COLOR" -ne 1 ]; then
        info "${current}/${total}  ${label}"
        return 0
    fi

    for ((i = 0; i < width; i++)); do
        if [ "$i" -lt "$filled" ]; then
            bar+="█"
        else
            bar+="░"
        fi
    done

    printf '\r\033[K  %s [%s]  %s/%s  %s' \
        "$(_c '1;36' '▸')" "$(_c '1;36' "$bar")" "$current" "$total" "$label"
}

list_enabled_repo_aliases() {
    /usr/bin/zypper --xmlout lr 2>/dev/null \
        | python3 /dev/fd/3 3<<'PY' 2>/dev/null || true
import re, sys
raw = sys.stdin.read()
for tag in re.finditer(r"<repo\b([^>]*)>", raw):
    attrs = tag.group(1)
    if not re.search(r'\benabled="1"', attrs):
        continue
    match = re.search(r'\balias="([^"]+)"', attrs)
    if match:
        print(match.group(1))
PY
}

version_gt() {
    local remote="$1" local_ver="$2"
    python3 -c '
import sys
def parts(v):
    out = []
    for p in v.lstrip("vV").split("."):
        try:
            out.append(int(p))
        except ValueError:
            out.append(0)
    return out
remote, current = sys.argv[1], sys.argv[2]
sys.exit(0 if parts(remote) > parts(current) else 1)
' "$remote" "$local_ver"
}

stop_packagekit() {
    local timeout_sec="${1:-3}"
    local end=$((SECONDS + timeout_sec))

    while [ "$SECONDS" -lt "$end" ]; do
        pkill -9 -x packagekitd 2>/dev/null || true
        sleep 0.1
    done
}

clear_zypp_lock() {
    echo "" > /run/zypp.pid
}

self_update_update_manager() {
    # Quiet unless there is a real update to install.
    start_spin "$(msg checking_self)"

    local json tag rpm_url current tmp_rpm
    if ! json=$(curl -fsSL \
        -A "update-manager-self-update" \
        -H "Accept: application/vnd.github+json" \
        "$GITHUB_API" 2>/dev/null); then
        stop_spin
        return 0
    fi

    tag=""
    rpm_url=""
    {
        read -r tag
        read -r rpm_url
    } < <(
        printf '%s' "$json" | python3 -c '
import json, sys
data = json.load(sys.stdin)
tag = data.get("tag_name", "") or ""
url = ""
for a in data.get("assets", []):
    name = a.get("name", "")
    if name.endswith(".rpm") and "update-manager" in name:
        url = a.get("browser_download_url", "") or ""
        break
print(tag)
print(url)
' 2>/dev/null || true
    ) || true

    if [ -z "${tag:-}" ] || [ -z "${rpm_url:-}" ]; then
        stop_spin
        return 0
    fi

    current=$(rpm -q --qf '%{VERSION}' "$PACKAGE_NAME" 2>/dev/null || true)
    if [ -z "${current:-}" ]; then
        current="0"
    fi

    if ! version_gt "$tag" "$current"; then
        stop_spin
        return 0
    fi

    stop_spin
    phase "$(msg phase_self)"
    upd "$(msg self_updating): $current → $tag"
    info "$(msg self_installing)…"

    tmp_rpm=$(mktemp /tmp/update-manager-XXXXXX.rpm)
    if curl -fsSL -A "update-manager-self-update" -o "$tmp_rpm" "$rpm_url" \
        && rpm -U --quiet "$tmp_rpm"; then
        ok "$(msg self_ok) ($tag)"
    else
        err "$(msg self_fail)"
    fi
    rm -f "$tmp_rpm"
}

EXPIRED_KEYS_REMOVED=0

cleanup_expired_rpm_keys() {
    EXPIRED_KEYS_REMOVED=0
    command -v gpg >/dev/null 2>&1 || return 0

    local now gpg_home key exp_info summary
    now=$(date +%s)
    gpg_home=$(mktemp -d /tmp/update-system-gpg-XXXXXX)
    chmod 700 "$gpg_home"

    while IFS= read -r key; do
        [ -z "$key" ] && continue
        exp_info=$(
            rpm -q --qf '%{DESCRIPTION}\n' "$key" 2>/dev/null \
                | gpg --homedir "$gpg_home" --with-colons --show-keys 2>/dev/null \
                | awk -F: -v now="$now" '$1=="pub" && ($2=="e" || ($7!="" && $7>0 && $7<=now)) {print $2, $7; exit}' \
                || true
        )
        if [ -n "$exp_info" ]; then
            summary=$(rpm -q --qf '%{SUMMARY}\n' "$key" 2>/dev/null || echo "$key")
            if rpm --erase --allmatches "$key" 2>/dev/null; then
                warn "$(msg expired_key_removed): $summary"
                EXPIRED_KEYS_REMOVED=1
            fi
        fi
    done < <(rpm -q gpg-pubkey --qf '%{NAME}-%{VERSION}-%{RELEASE}\n' 2>/dev/null || true)

    rm -rf "$gpg_home"
}

refresh_repos() {
    local -a repos=()
    local -a refresh_args=(--gpg-auto-import-keys -n refresh)
    local alias=""
    local i=0
    local total=0
    local rc=0

    phase "$(msg phase_repos)"
    cleanup_expired_rpm_keys
    if [ "$EXPIRED_KEYS_REMOVED" -eq 1 ]; then
        refresh_args+=(-f)
    fi
    info "$(msg refreshing_repos)"

    clear_zypp_lock
    stop_packagekit 3 &
    disown || true
    sleep 0.3

    while IFS= read -r alias; do
        [ -n "$alias" ] && repos+=("$alias")
    done < <(list_enabled_repo_aliases)

    total=${#repos[@]}

    # Fallback: listing failed or empty — single global refresh with spinner.
    if [ "$total" -eq 0 ]; then
        start_spin "$(msg refreshing_repos)"
        clear_zypp_lock
        set +e
        /usr/bin/zypper "${refresh_args[@]}" >/dev/null 2>&1
        set -e
        stop_spin
        ok "$(msg repos_done)"
        return 0
    fi

    for alias in "${repos[@]}"; do
        i=$((i + 1))
        draw_progress "$i" "$total" "$alias"
        clear_zypp_lock
        set +e
        /usr/bin/zypper "${refresh_args[@]}" "$alias" >/dev/null 2>&1
        rc=$?
        set -e
        if [ "$rc" -ne 0 ]; then
            if [ "$USE_COLOR" -eq 1 ]; then
                printf '\r\033[K'
            fi
            warn "$(msg repo_fail): $alias"
        fi
    done

    if [ "$USE_COLOR" -eq 1 ]; then
        printf '\r\033[K'
    fi
    ok "$(msg repos_done) ($total)"
}

run_upgrade() {
    local rc
    phase "$(msg phase_upgrade)"
    info "$(msg proceeding)"
    echo

    clear_zypp_lock
    set +e
    "${ZYPPER_UPGRADE[@]}"
    rc=$?
    set -e

    # zypper 100-103 are informational (updates pending, reboot/restart suggested), not failures.
    case "$rc" in 100|101|102|103) rc=0 ;; esac
    UPGRADE_RC=$rc
    if [ "$rc" -ne 0 ] && [ "$CONSOLE_REPORTS_RESULT" -eq 0 ]; then
        echo
        err "$(msg something_wrong)"
    fi
}

run_as_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "$(msg must_be_root)" >&2
        exit 1
    fi

    export ZYPP_CURL2=1
    export ZYPP_PCK_PRELOAD=1
    export ZYPP_MEDIANETWORK=1

    trap 'stop_spin' EXIT

    self_update_update_manager

    refresh_repos
    run_upgrade

    rm -rf /var/tmp/rpm-tmp.* /var/tmp/zypp.*
    rm -f /var/log/update-checker/updates.xml

    exit "$UPGRADE_RC"
}

wait_for_enter() {
    echo
    info "$(msg press_enter)"
    if [ -r /dev/tty ] && [ -w /dev/tty ]; then
        read -r _ </dev/tty || true
    else
        read -r _ || true
    fi
}

print_usage() {
    msg usage
}

poll_update_viewer() {
    timeout 3 dbus-send --session --type=method_call \
        --dest=org.updateViewer /org/updateViewer \
        org.updateViewer.Manager.poll_updates >/dev/null 2>&1 || true
}

resolve_script_path() {
    local p="$0"
    if command -v readlink >/dev/null 2>&1; then
        local resolved
        resolved="$(readlink -f "$p" 2>/dev/null || true)"
        if [ -n "$resolved" ]; then
            printf '%s\n' "$resolved"
            return 0
        fi
    fi
    if command -v realpath >/dev/null 2>&1; then
        local resolved
        resolved="$(realpath "$p" 2>/dev/null || true)"
        if [ -n "$resolved" ]; then
            printf '%s\n' "$resolved"
            return 0
        fi
    fi
    case "$p" in
        /*) printf '%s\n' "$p" ;;
        *) printf '%s\n' "$(pwd)/$p" ;;
    esac
}

notify_no_console() {
    local message
    message="$(msg no_console)"
    echo "$message" >&2
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --no-wrap --text="$message" 2>/dev/null || true
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --error "$message" 2>/dev/null || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg terminal_title)" "$message" 2>/dev/null || true
    fi
}

find_update_console() {
    if [ -x /usr/bin/update-console ]; then
        printf '%s\n' /usr/bin/update-console
        return 0
    fi
    # Dev / unpackaged layout: console beside this script
    local script_dir
    script_dir="$(CDPATH= cd -- "$(dirname -- "$(resolve_script_path)")" && pwd)"
    if [ -x "$script_dir/update-console" ]; then
        printf '%s\n' "$script_dir/update-console"
        return 0
    fi
    return 1
}

open_update_console() {
    local console
    if ! console="$(find_update_console)"; then
        notify_no_console
        return 1
    fi
    "$console" </dev/null >/dev/null 2>&1 &
    disown
}

run_interactive_upgrade() {
    # A non-zero status (e.g. zypper answered "no") must not skip wait_for_enter under set -e.
    "$RUN_PRIVILEGED" "$0" --root || true
    wait_for_enter
    poll_update_viewer
}

if [ -n "${DISPLAY:-}" ] && [ -z "${SSH_CONNECTION:-}" ] && [ -z "${SSH_CLIENT:-}" ] && [ -z "${SSH_TTY:-}" ]; then
    RUN_PRIVILEGED="/usr/bin/pkexec"
else
    RUN_PRIVILEGED="/usr/bin/sudo"
fi

case "${1:-}" in
    --root)
        if [ "${2:-}" = "--console" ]; then
            CONSOLE_REPORTS_RESULT=1
        fi
        run_as_root
        ;;
    --launch)
        run_interactive_upgrade
        ;;
    -h|--help)
        print_usage
        exit 0
        ;;
    "")
        if [ "$RUN_PRIVILEGED" = "/usr/bin/pkexec" ]; then
            open_update_console
        else
            run_interactive_upgrade
        fi
        ;;
    *)
        print_usage >&2
        exit 2
        ;;
esac
