#!/bin/bash
# System upgrade launcher with optional self-update of update-manager.

set -euo pipefail

GITHUB_API="https://api.github.com/repos/jpmsb/update-manager/releases/latest"
PACKAGE_NAME="update-manager"
ZYPPER_UPGRADE="/usr/bin/zypper dist-upgrade --auto-agree-with-licenses --replacefiles --force-resolution"

detect_ui_lang() {
    local lang="${LC_ALL:-${LC_MESSAGES:-${LANG:-en_US.UTF-8}}}"
    lang="${lang%%.*}"
    lang="${lang%%_*}"
    lang=$(echo "$lang" | tr '[:upper:]' '[:lower:]')
    case "$lang" in
        pt) echo "pt" ;;
        *) echo "en" ;;
    esac
}

UI_LANG="$(detect_ui_lang)"

msg() {
    local key="$1"
    case "$UI_LANG:$key" in
        pt:terminal_title) echo "Instalar atualizações" ;;
        pt:checking_self) echo "Verificando atualização do update-manager..." ;;
        pt:self_up_to_date) echo "update-manager já está na versão mais recente." ;;
        pt:self_updating) echo "Atualizando update-manager..." ;;
        pt:self_ok) echo "update-manager atualizado com sucesso." ;;
        pt:self_fail) echo "Falha ao atualizar update-manager; continuando com a atualização do sistema." ;;
        pt:self_skip_net) echo "Não foi possível consultar o GitHub; continuando com a atualização do sistema." ;;
        pt:refreshing_repos) echo "Atualizando as informações dos repositórios" ;;
        pt:running) echo "Executando" ;;
        pt:proceeding) echo "Prosseguindo para a atualização dos pacotes..." ;;
        pt:review) echo "Verifique o que será realizado antes de prosseguir!!" ;;
        pt:something_wrong) echo "Algo deu errado!! Você pode tentar novamente." ;;
        pt:press_enter) echo "Pressione ENTER para sair..." ;;
        pt:must_be_root) echo "Este modo requer root." ;;

        *:terminal_title) echo "Install updates" ;;
        *:checking_self) echo "Checking for update-manager updates..." ;;
        *:self_up_to_date) echo "update-manager is already up to date." ;;
        *:self_updating) echo "Updating update-manager..." ;;
        *:self_ok) echo "update-manager updated successfully." ;;
        *:self_fail) echo "Failed to update update-manager; continuing with the system upgrade." ;;
        *:self_skip_net) echo "Could not query GitHub; continuing with the system upgrade." ;;
        *:refreshing_repos) echo "Refreshing repository metadata" ;;
        *:running) echo "Running" ;;
        *:proceeding) echo "Proceeding with package upgrade..." ;;
        *:review) echo "Review what will be done before continuing!!" ;;
        *:something_wrong) echo "Something went wrong!! You can try again." ;;
        *:press_enter) echo "Press ENTER to exit..." ;;
        *:must_be_root) echo "This mode requires root." ;;
        *) echo "$key" ;;
    esac
}

box() {
    local sentence="$1"
    local sentence_length=${#sentence}
    local horizontal_spacing=$((sentence_length + 2))
    local left_upper="╔" right_upper="╗" left_bottom="╚" right_bottom="╝"
    local horizontal="═" vertical="║" horizontal_line="" i

    for i in $(seq 1 "$horizontal_spacing"); do
        horizontal_line="${horizontal}${horizontal_line}"
    done

    echo "${left_upper}${horizontal_line}${right_upper}"
    echo "${vertical}${horizontal_line//$horizontal/ }${vertical}"
    echo "${vertical} ${sentence} ${vertical}"
    echo "${vertical}${horizontal_line//$horizontal/ }${vertical}"
    echo "${left_bottom}${horizontal_line}${right_bottom}"
}

version_gt() {
    # Compare dotted numeric versions (e.g. 2026.09.29.0017) as integer tuples.
    # sort -V is unreliable with leading zeros in the HHMM segment.
    local remote="$1" local_ver="$2"
    python3 -c '
import sys
def parts(v):
    out = []
    for p in v.lstrip("vV").split("."):
        try:
            out.append(int(p))
        except ValueError:
            out.append(0)
    return out
remote, current = sys.argv[1], sys.argv[2]
sys.exit(0 if parts(remote) > parts(current) else 1)
' "$remote" "$local_ver"
}

stop_packagekit() {
    local timeout_sec="${1:-3}"
    local end=$((SECONDS + timeout_sec))

    while [ "$SECONDS" -lt "$end" ]; do
        pkill -f "packagekitd" -9 2>/dev/null || true
        sleep 0.1
    done
}

self_update_update_manager() {
    box "$(msg checking_self)"

    local json tag rpm_url current tmp_rpm
    if ! json=$(curl -fsSL \
        -A "update-manager-self-update" \
        -H "Accept: application/vnd.github+json" \
        "$GITHUB_API" 2>/dev/null); then
        box "$(msg self_skip_net)"
        return 0
    fi

    # Parse tag_name and first matching RPM asset URL (python3 already required by the package).
    tag=""
    rpm_url=""
    {
        read -r tag
        read -r rpm_url
    } < <(
        printf '%s' "$json" | python3 -c '
import json, sys
data = json.load(sys.stdin)
tag = data.get("tag_name", "") or ""
url = ""
for a in data.get("assets", []):
    name = a.get("name", "")
    if name.endswith(".rpm") and "update-manager" in name:
        url = a.get("browser_download_url", "") or ""
        break
print(tag)
print(url)
' 2>/dev/null || true
    ) || true

    if [ -z "${tag:-}" ] || [ -z "${rpm_url:-}" ]; then
        box "$(msg self_skip_net)"
        return 0
    fi

    current=$(rpm -q --qf '%{VERSION}' "$PACKAGE_NAME" 2>/dev/null || true)
    if [ -z "${current:-}" ]; then
        current="0"
    fi

    if ! version_gt "$tag" "$current"; then
        box "$(msg self_up_to_date)"
        return 0
    fi

    box "$(msg self_updating)"
    tmp_rpm=$(mktemp /tmp/update-manager-XXXXXX.rpm)
    if curl -fsSL -A "update-manager-self-update" -o "$tmp_rpm" "$rpm_url" \
        && rpm -Uvh "$tmp_rpm"; then
        box "$(msg self_ok)"
    else
        box "$(msg self_fail)"
    fi
    rm -f "$tmp_rpm"
}

refresh_repos() {
    local command="$1"
    box "$(msg refreshing_repos)"
    box "$(msg running) \"$command\""
    set +e
    $command
    set -e
    sleep 1
}

run_upgrade() {
    local command="$1" rc
    echo "" > /run/zypp.pid

    box "$(msg proceeding)"
    box "$(msg running) \"$command\""
    box "$(msg review)"

    set +e
    $command
    rc=$?
    set -e

    if [ "$rc" -ne 0 ]; then
        box "$(msg something_wrong)"
    fi
}

run_as_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "$(msg must_be_root)" >&2
        exit 1
    fi

    export ZYPP_CURL2=1
    export ZYPP_PCK_PRELOAD=1
    export ZYPP_MEDIANETWORK=1

    self_update_update_manager

    refresh_repos "pkcon get-updates"
    stop_packagekit 3 &
    disown || true
    run_upgrade "$ZYPPER_UPGRADE"

    rm -rf /var/tmp/rpm-tmp.* /var/tmp/zypp.*
    rm -f /var/log/update-checker/updates.xml
}

wait_for_enter() {
    echo
    echo "$(msg press_enter)"
    if [ -r /dev/tty ] && [ -w /dev/tty ]; then
        read -r _ </dev/tty || true
    else
        read -r _ || true
    fi
}

if [ -n "${DISPLAY:-}" ] && [ -z "${SSH_CONNECTION:-}" ] && [ -z "${SSH_CLIENT:-}" ] && [ -z "${SSH_TTY:-}" ]; then
    RUN_PRIVILEGED="/usr/bin/pkexec"
else
    RUN_PRIVILEGED="/usr/bin/sudo"
fi

case "${1:-}" in
    --root)
        run_as_root
        ;;
    "")
        if [ "$RUN_PRIVILEGED" = "/usr/bin/pkexec" ]; then
            /usr/bin/xfce4-terminal \
                --hide-menubar \
                --hide-toolbar \
                --zoom 1.5 \
                --maximize \
                -e "$0 0" \
                -T "$(msg terminal_title)" \
                >/dev/null 2>&1 & disown
        else
            "$RUN_PRIVILEGED" "$0" --root
            wait_for_enter
            timeout 3 dbus-send --session --type=method_call \
                --dest=org.updateViewer /org/updateViewer \
                org.updateViewer.Manager.poll_updates >/dev/null 2>&1 || true
        fi
        ;;
    *)
        # Terminal path (arg "0") or any other non-empty arg: elevate then wait.
        "$RUN_PRIVILEGED" "$0" --root
        wait_for_enter
        timeout 3 dbus-send --session --type=method_call \
            --dest=org.updateViewer /org/updateViewer \
            org.updateViewer.Manager.poll_updates >/dev/null 2>&1 || true
        ;;
esac
