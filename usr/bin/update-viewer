        self.after_remind_combo.setCurrentIndex(index)
        self.after_remind_combo.setMinimumWidth(200)  # Define largura mínima para alinhamento
        after_remind_layout.addWidget(self.after_remind_combo)
        behavior_layout.addLayout(after_remind_layout)

        # Open window on notification click
        open_window_layout = QHBoxLayout()
        self.open_window_checkbox = QCheckBox(_("Abrir a janela principal ao clicar na notificação"))
        open_window_value = self.current_config.get('open-window-on-notification-click', True)
        # Garante que seja boolean
        if isinstance(open_window_value, bool):
            self.open_window_checkbox.setChecked(open_window_value)
        else:
            self.open_window_checkbox.setChecked(str(open_window_value).lower() in ['true', '1', 'yes', 'on'])
        open_window_layout.addWidget(self.open_window_checkbox)
        behavior_layout.addLayout(open_window_layout)
        
        behavior_group.setLayout(behavior_layout)
        scroll_layout.addWidget(behavior_group)
        
